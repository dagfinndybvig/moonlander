005114          JMP NEXT
005120          .HEAD "VARIABLE", VARC
005136  VARC:   JSR PC, WORD                ; read the name into WORDBUF
005142          MOV #DOVAR, -(SP)
005146          JSR PC, CREATEHDR
005152          CLR -(SP)
005154          JSR PC, CC
005160          JMP NEXT
005164          .HEAD "CONSTANT", CONSC
005202  CONSC:  JSR PC, WORD                ; read the name into WORDBUF
005206          MOV #DOCON, -(SP)
005212          JSR PC, CREATEHDR
005216          JSR PC, CC
005222          JMP NEXT
005226          .HEAD "CREATE", CREATEC
005242  CREATEC: JSR PC, WORD               ; read the name into WORDBUF
005246          MOV #DOVAR, -(SP)
005252          JSR PC, CREATEHDR
005256          JMP NEXT
005262          .HEAD "IMMEDIATE", IMMC
005302  IMMC:   MOV @#LATEST, R0
005306          BISB #0o200, 3(R0)
005314          JMP NEXT
005320          .HEAD "LITERAL", LITW, 0o300
005336  LITW:   MOV #LITCFA, -(SP)
005342          JSR PC, CC
005346          JSR PC, CC
005352          JMP NEXT
005356          .HEAD "IF", IFW, 0o300
005366  IFW:    MOV #QBRCFA, -(SP)          ; IF is a zero-branch: jump if false
005372          JSR PC, CC
005376          MOV @#DPPTR, -(SP)          ; the offset cell, kept on the stack
005402          CLR -(SP)
005404          JSR PC, CC
005410          JMP NEXT
005414          .HEAD "ELSE", ELSEW, 0o300
005426  ELSEW:  MOV #BRCFA, -(SP)
005432          JSR PC, CC
005436          MOV @#DPPTR, -(SP)          ; this ELSE's offset cell
005442          CLR -(SP)
005444          JSR PC, CC
005450          MOV 2(SP), R1               ; IF's cell, one below
005454          MOV @#DPPTR, R2
005460          SUB R1, R2
005462          SUB #2, R2                  ; IP lands past IF's cell
005466          MOV R2, (R1)                ; patch IF to branch here
005470          MOV (SP), 2(SP)             ; drop IF's cell: THEN expects only
005474          TST (SP)+                   ; ELSE's to remain
005476          JMP NEXT
005502          .HEAD "THEN", THENW, 0o300
005514  THENW:  MOV (SP)+, R0
005516          MOV @#DPPTR, R1
005522          SUB R0, R1
005524          SUB #2, R1                  ; IP lands past the offset cell
005530          MOV R1, (R0)
005532          JMP NEXT
005536          .HEAD "BEGIN", BEGINW, 0o300
005552  BEGINW: MOV @#DPPTR, -(SP)
005556          JMP NEXT
005562          .HEAD "UNTIL", UNTILW, 0o300
005576  UNTILW: MOV #QBRCFA, -(SP)
005602          JSR PC, CC
005606          MOV @#DPPTR, R1
005612          ADD #2, R1                  ; IP lands past the offset cell
005616          MOV (SP)+, R0
005620          SUB R1, R0
005622          MOV R0, -(SP)
005624          JSR PC, CC
005630          JMP NEXT
005634          .HEAD "WHILE", WHILEW, 0o300
005650  WHILEW: MOV #QBRCFA, -(SP)          ; branch out when the flag is false
005654          JSR PC, CC
005660          CLR -(SP)                   ; reserve the offset cell
005662          JSR PC, CC
005666          MOV @#DPPTR, R0             ; the placeholder's address (CC clobbers R0)
005672          SUB #2, R0
005676          MOV R0, -(SP)
005700          JMP NEXT
005704          .HEAD "REPEAT", REPEATW, 0o300
005720  REPEATW: MOV (SP)+, R0              ; WHILE's offset cell
005722          MOV (SP)+, R1               ; BEGIN's address
005724          MOV R0, -(SP)               ; WHILE's cell, patched below
005726          MOV R1, -(SP)               ; BEGIN's address survives the CC
005730          MOV #BRCFA, -(SP)
005734          JSR PC, CC                  ; back-branch cell
005740          MOV @#DPPTR, R2
005744          ADD #2, R2                  ; IP lands past this offset cell
005750          SUB R2, (SP)                ; branch back to BEGIN
005752          JSR PC, CC                  ; back-branch offset
005756          MOV @#DPPTR, R2             ; final DP = the exit target
005762          MOV (SP)+, R0               ; WHILE's cell
005764          SUB R0, R2
005766          SUB #2, R2                  ; IP lands past WHILE's cell
005772          MOV R2, (R0)                ; patch WHILE to here
005774          JMP NEXT
006000          .HEAD "DO", DOW, 0o300
006010  DOW:    MOV #DOCFA, -(SP)
006014          JSR PC, CC
006020          MOV @#DPPTR, -(SP)          ; loop body start
006024          JMP NEXT
006030          .HEAD "LOOP", LOOPW, 0o300
006042  LOOPW:  MOV #LOOPCFA, -(SP)
006046          JSR PC, CC
006052          MOV @#DPPTR, R1
006056          ADD #2, R1                  ; IP lands past the offset cell
006062          MOV (SP)+, R0
006064          SUB R1, R0
006066          MOV R0, -(SP)
006070          JSR PC, CC
006074          JMP NEXT
006100          .HEAD "BYE", BYEC
006112  BYEC:   .WORD 0o000000              ; HALT: the processor stops, the VT11
