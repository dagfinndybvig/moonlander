001612          JMP @(R3)+
001614  DOCOL:  MOV R4, -(R5)               ; colon code: push IP, enter the thread
001616          MOV R3, R4                  ; R3 already points at the first body cell
001620          JMP NEXT
001624  DOCON:  MOV (R3), -(SP)             ; constant: push the parameter
001626          JMP NEXT
001632  DOVAR:  MOV R3, -(SP)               ; variable: push the parameter address
001634          JMP NEXT
001640  EXIT:   MOV (R5)+, R4
001642          JMP NEXT
