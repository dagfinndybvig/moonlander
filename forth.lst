005214          .HEAD "CREATE", CREATEC
005230  CREATEC: JSR PC, WORD               ; read the name into WORDBUF
005234          MOV #DOVAR, -(SP)
005240          JSR PC, CREATEHDR
005244          JMP NEXT
005250          .HEAD "IMMEDIATE", IMMC
005270  IMMC:   MOV @#LATEST, R0
005274          BISB #0o200, 3(R0)
005302          JMP NEXT
005306          .HEAD "LITERAL", LITW, 0o300
005324  LITW:   MOV #LITCFA, -(SP)
005330          JSR PC, CC
005334          JSR PC, CC
005340          JMP NEXT
005344          .HEAD "IF", IFW, 0o300
005354  IFW:    MOV #QBRCFA, -(SP)          ; IF is a zero-branch: jump if false
005360          JSR PC, CC
005364          MOV @#DPPTR, -(SP)          ; the offset cell, kept on the stack
005370          CLR -(SP)
005372          JSR PC, CC
005376          JMP NEXT
005402          .HEAD "ELSE", ELSEW, 0o300
005414  ELSEW:  MOV #BRCFA, -(SP)
005420          JSR PC, CC
005424          MOV @#DPPTR, -(SP)          ; this ELSE's offset cell
005430          CLR -(SP)
005432          JSR PC, CC
005436          MOV 2(SP), R1               ; IF's cell, one below
005442          MOV @#DPPTR, R2
005446          SUB R1, R2
005450          SUB #2, R2                  ; IP lands past IF's cell
005454          MOV R2, (R1)                ; patch IF to branch here
005456          MOV (SP), 2(SP)             ; drop IF's cell: THEN expects only
005462          TST (SP)+                   ; ELSE's to remain
005464          JMP NEXT
005470          .HEAD "THEN", THENW, 0o300
005502  THENW:  MOV (SP)+, R0
005504          MOV @#DPPTR, R1
005510          SUB R0, R1
005512          SUB #2, R1                  ; IP lands past the offset cell
005516          MOV R1, (R0)
005520          JMP NEXT
005524          .HEAD "BEGIN", BEGINW, 0o300
005540  BEGINW: MOV @#DPPTR, -(SP)
005544          JMP NEXT
005550          .HEAD "UNTIL", UNTILW, 0o300
005564  UNTILW: MOV #QBRCFA, -(SP)
005570          JSR PC, CC
005574          MOV @#DPPTR, R1
005600          ADD #2, R1                  ; IP lands past the offset cell
005604          MOV (SP)+, R0
005606          SUB R1, R0
005610          MOV R0, -(SP)
005612          JSR PC, CC
005616          JMP NEXT
005622          .HEAD "WHILE", WHILEW, 0o300
005636  WHILEW: MOV #QBRCFA, -(SP)          ; branch out when the flag is false
005642          JSR PC, CC
005646          CLR -(SP)                   ; reserve the offset cell
005650          JSR PC, CC
005654          MOV @#DPPTR, R0             ; the placeholder's address (CC clobbers R0)
005660          SUB #2, R0
005664          MOV R0, -(SP)
005666          JMP NEXT
005672          .HEAD "REPEAT", REPEATW, 0o300
005706  REPEATW: MOV (SP)+, R0              ; WHILE's offset cell
005710          MOV (SP)+, R1               ; BEGIN's address
005712          MOV R0, -(SP)               ; WHILE's cell, patched below
005714          MOV R1, -(SP)               ; BEGIN's address survives the CC
005716          MOV #BRCFA, -(SP)
005722          JSR PC, CC                  ; back-branch cell
005726          MOV @#DPPTR, R2
005732          ADD #2, R2                  ; IP lands past this offset cell
005736          SUB R2, (SP)                ; branch back to BEGIN
005740          JSR PC, CC                  ; back-branch offset
005744          MOV @#DPPTR, R2             ; final DP = the exit target
005750          MOV (SP)+, R0               ; WHILE's cell
005752          SUB R0, R2
005754          SUB #2, R2                  ; IP lands past WHILE's cell
005760          MOV R2, (R0)                ; patch WHILE to here
005762          JMP NEXT
005766          .HEAD "DO", DOW, 0o300
005776  DOW:    MOV #DOCFA, -(SP)
006002          JSR PC, CC
006006          MOV @#DPPTR, -(SP)          ; loop body start
006012          JMP NEXT
006016          .HEAD "LOOP", LOOPW, 0o300
006030  LOOPW:  MOV #LOOPCFA, -(SP)
006034          JSR PC, CC
006040          MOV @#DPPTR, R1
006044          ADD #2, R1                  ; IP lands past the offset cell
006050          MOV (SP)+, R0
006052          SUB R1, R0
006054          MOV R0, -(SP)
006056          JSR PC, CC
006062          JMP NEXT
006066          .HEAD "BYE", BYEC
006100  BYEC:   .WORD 0o000000              ; HALT: the processor stops, the VT11
