005372          JSR PC, CC
005376          JMP NEXT
005402          .HEAD "ELSE", ELSEW, 0o200
005414  ELSEW:  MOV #BRCFA, -(SP)
005420          JSR PC, CC
005424          MOV @#DPPTR, -(SP)          ; this ELSE's offset cell
005430          CLR -(SP)
005432          JSR PC, CC
005436          MOV 2(SP), R1               ; IF's cell, one below
005442          MOV @#DPPTR, R2
005446          SUB R1, R2
005450          SUB #2, R2                  ; IP lands past IF's cell
005454          MOV R2, (R1)                ; patch IF to branch here
005456          JMP NEXT
005462          .HEAD "THEN", THENW, 0o200
005474  THENW:  MOV (SP)+, R0
005476          MOV @#DPPTR, R1
005502          SUB R0, R1
005504          SUB #2, R1                  ; IP lands past the offset cell
005510          MOV R1, (R0)
005512          JMP NEXT
005516          .HEAD "BEGIN", BEGINW, 0o200
005532  BEGINW: MOV @#DPPTR, -(SP)
005536          JMP NEXT
005542          .HEAD "UNTIL", UNTILW, 0o200
005556  UNTILW: MOV #QBRCFA, -(SP)
005562          JSR PC, CC
005566          MOV @#DPPTR, R1
005572          ADD #2, R1                  ; IP lands past the offset cell
005576          MOV (SP)+, R0
005600          SUB R1, R0
005602          MOV R0, -(SP)
005604          JSR PC, CC
005610          JMP NEXT
005614          .HEAD "WHILE", WHILEW, 0o200
005630  WHILEW: MOV #QBRCFA, -(SP)          ; branch out when the flag is false
005634          JSR PC, CC
005640          CLR -(SP)                   ; reserve the offset cell
005642          JSR PC, CC
005646          MOV @#DPPTR, R0             ; the placeholder's address (CC clobbers R0)
005652          SUB #2, R0
005656          MOV R0, -(SP)
005660          JMP NEXT
005664          .HEAD "REPEAT", REPEATW, 0o200
005700  REPEATW: MOV (SP)+, R0              ; WHILE's offset cell
005702          MOV (SP)+, R1               ; BEGIN's address
005704          MOV R0, -(SP)               ; WHILE's cell, patched below
005706          MOV R1, -(SP)               ; BEGIN's address survives the CC
005710          MOV #BRCFA, -(SP)
005714          JSR PC, CC                  ; back-branch cell
005720          MOV @#DPPTR, R2
005724          ADD #2, R2                  ; IP lands past this offset cell
005730          SUB R2, (SP)                ; branch back to BEGIN
005732          JSR PC, CC                  ; back-branch offset
005736          MOV @#DPPTR, R2             ; final DP = the exit target
005742          MOV (SP)+, R0               ; WHILE's cell
005744          SUB R0, R2
005746          SUB #2, R2                  ; IP lands past WHILE's cell
005752          MOV R2, (R0)                ; patch WHILE to here
005754          JMP NEXT
005760          .HEAD "DO", DOW, 0o200
005770  DOW:    MOV #DOCFA, -(SP)
005774          JSR PC, CC
006000          MOV @#DPPTR, -(SP)          ; loop body start
006004          JMP NEXT
006010          .HEAD "LOOP", LOOPW, 0o200
006022  LOOPW:  MOV #LOOPCFA, -(SP)
006026          JSR PC, CC
006032          MOV @#DPPTR, R1
006036          ADD #2, R1                  ; IP lands past the offset cell
006042          MOV (SP)+, R0
006044          SUB R1, R0
006046          MOV R0, -(SP)
006050          JSR PC, CC
006054          JMP NEXT
