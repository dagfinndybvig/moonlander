# The edit list for a 32-second loop of the McDonald's flight, made for
# sharing. Made with:
#
#   cargo build --release --example film
#   ./target/release/examples/film mcdonalds 30 1080 1080 docs/film/moonlander-loop.edit \
#     | ffmpeg -f rawvideo -pix_fmt rgb24 -s 1080x1080 -r 30 -i - -c:v libx264 \
#       -preset slow -crf 16 -x264-params aq-mode=3 -pix_fmt yuv420p \
#       -movflags +faststart moonlander-loop.mp4
#
# Moonlander, a loop: one flight to the McDonald's and back, played
# continuously at varying speed, ending at the same moment of the next
# flight, so the film can repeat without a seam. The flights start
# (RESTAR) at 30.102 s and 314.484 s; the film starts 0.998 s into the
# first and ends 0.998 s into the second, at 6x both times.

# Over the mountains, then the close-up view.
0     31.100
1     37.100
4     120
6     184
7.5   192
8.5   196
# Down to the McDonald's: "TAKE IT NICE AND EASY".
11.5  209
14    214
# Touchdown, the dust, "FANTASTIC, A PERFECT LANDING".
17    219
18.5  222
# The walk to the counter, and the order.
20.5  252
21.5  255.2
24.5  262.3
# Back to the ship, and off.
26    295
27    297.5
30    307.5
31.5  313
31.914 315.482

# Full face, then closer for the landing site, the walk and the order.
camera 0     512 384 1024
camera 16.3  512 384 1024
camera 18.3  412 322 660
camera 26.3  412 322 660
camera 28.3  512 384 1024
