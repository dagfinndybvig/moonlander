@@ -318,8 +321,12 @@ t_stat
 vt_svc(UNIT *uptr)
 {
     sim_debug (DEB_TRC, &vt_dev, "vt_svc(wait=%d,DPC=0%o)\n", uptr->wait, vt11_get_dpc());
-    if (vt11_cycle(uptr->wait, 0))
