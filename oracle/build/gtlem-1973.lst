    2062 012130 001406                          BEQ     LIGHTG                  ;YES. MAYBE WE CAN PROCESS IT.
    2063 012132 012767  000017  165770          MOV     #15.,HITCNT             ;NOT SAME. SET UP HIT COUNTER
    2064 012140 010167  165762                  MOV     IN2,OLDHIT              ;AND THE OLD REGISTER  NOW.
    2065 012144 000450                          BR      LPRESM                  ;AND EXIT NOW.
    2066 012146 005367  165756          LIGHTG: DEC     HITCNT                  ;HAVE WE BEEN HIT ENOUGH?
    2067 012152 100045                          BPL     LPRESM                  ;NO. GET OUT NOW.
    2068 012154 006301                          ASL     IN2                     ;ELSE SHIFT THE INDEX OVER
    2069 012156 000171  012502'                 JMP     @LPTAB(IN2)             ;AND GO PROCESS INTERUPT.
