    2166                                ;
    2167                                ;               THIS ROUTINE WILL CALCULATE THE VALUES THAT THE
    2168                                ;               USER WISHES TO HAVE DISPLAYED.
    2169                                ;
    2170 012572 010046                  DIAL:   MOV     IN1,-(SP)               ;SAVE ALL THE IMPORTANT REGISTERS NOW.
    2171 012574 010146                          MOV     IN2,-(SP)
    2172 012576 010246                          MOV     RET1,-(SP)
    2173 012600 010346                          MOV     RET2,-(SP)
    2174 012602 010446                          MOV     TEMP,-(SP)
    2175 012604 010546                          MOV     TEMP2,-(SP)
    2176 012606 005004                          CLR     TEMP                    ;NOW SET POINTER TO FIRST ITEM.
    2177 012610 016405  013216'         DIALL:  MOV     DIALTB(TEMP),TEMP2      ;PICK UP POINTER TO AN ITEM ENTRY.
    2178 012614 001440                          BEQ     DIALD1                  ;IF ZERO, THEN END OF LIST.
    2179 012616 016401  013230'                 MOV     DIALTC(TEMP),IN2        ;PICK UP POINTER TO WHERE TO
    2180 012622 010503                          MOV     TEMP2,RET2              ;DISPLAY CALCULATED VALUES.
    2181 012624 062703  000012                  ADD     #10.,RET2               ;CALCULATE "ITEMFX" ENTRY ADDRESS.
    2182 012630 010361  000022                  MOV     RET2,18.(IN2)           ;AND INSERT IT IN THE DISJMP OF
    2183 012634 017503  177774                  MOV     @-4(TEMP2),RET2         ;THE DITEMX TABLE. PICK UP USERS NUMBER NOW.
    2184 012640 016500  177776                  MOV     -2(TEMP2),IN1           ;PICK UP THE DIVISOR <IF ANY>.
    2185 012644 001412                          BEQ     DIALND                  ;NONE. DO NOT DIVIDE. DISPLAY AS IS.
    2186 012646 005703                          TST     RET2                    ;NOW MAKE ANSWER POSITIVE.
    2187 012650 100001                          BPL     DIALLP
    2188 012652 005403                          NEG     RET2
    2189 012654 005002                  DIALLP: CLR     RET1                    ;GET RID OF THE HIGH PART.
    2190 012656 004767  176274                  JSR     PC,DIVTWO               ;DO THE DIVISION NOW.
    2191 012662 005775  177774                  TST     @-4(TEMP2)              ;NOW RESTORE THE SIGN.
    2192 012666 100001                          BPL     DIALND
    2193 012670 005403                          NEG     RET2
    2194 012672 016405  013230'         DIALND: MOV     DIALTC(TEMP),TEMP2      ;PICK UP DITEMX POINTER AGAIN.
    2195 012676 010300                          MOV     RET2,IN1                ;MOVE OVER NUMBER NOW.
    2196 012700 012701  000012                  MOV     #10.,IN2                ;NOW CREATE ADDRESS OF WHERE TO LEAVE ANSWER
    2197 012704 060501                          ADD     TEMP2,IN2               ;AFTER CONVERTING TO ASCII STRING.
    2198 012706 004767  000254                  JSR     PC,SASCII               ;DO THE CONVERSION NOW.
    2199 012712 005724                          TST     (TEMP)+                 ;FINALLY INCREMENT POINTER TO NEXT ITEM.
    2200 012714 000735                          BR      DIALL                   ;AND GO BACK UP TO TOP AND GET NEXT VALUE.
    2201 012716 026767  165112  165112  DIALD1: CMP     PERCNT,OLDPER           ;CONVERT PERCENTAGE NOW. ANY CHANGE?
    2202 012724 001410                          BEQ     DIALRT                  ;NO. JUST EXIT.
    2203 012726 012701  022672'                 MOV     #LPBARC,IN2             ;YES. GET ADDRESS OF WHERE TO PLACE STRING.
    2204 012732 016700  165076                  MOV     PERCNT,IN1              ;GET THE NUMBER NOW.
    2205 012736 010067  165074                  MOV     IN1,OLDPER              ;UPDATE OLD PERCENTAGE NOW.
    2206 012742 004767  000220                  JSR     PC,SASCII               ;AND CONVERT IT NOW.
    2207 012746 012605                  DIALRT: MOV     (SP)+,TEMP2             ;RESTORE ALL THE ACTIVE REGISTERS NOW.
    2208 012750 012604                          MOV     (SP)+,TEMP
    2209 012752 012603                          MOV     (SP)+,RET2
    2210 012754 012602                          MOV     (SP)+,RET1
    2211 012756 012601                          MOV     (SP)+,IN2
    2212 012760 012600                          MOV     (SP)+,IN1
    2213 012762 000207                          RTS     PC                      ;AND RETURN NOW.
    2214                                        .PAGE
    2215                                ;
    2216                                ;               THIS ROUTINE CONVERT THE BINARY NUMBER (UNSIGNED)
    2217                                ;               IN THE REGISTER "IN1" INTO AN ASCII STRING SIX
    2218                                ;               CHARACTERS LONG AND LEAVES THE ANSWER TO WHERE "IN2"
    2219                                ;               POINTS TO. THE ANSWER IS PUT RIGHT JUSTIFIED WITH
    2220                                ;               LEADING BLANKS.
    2221                                ;
    2222 012764 112721  000040          ASCII:  MOVB    #' ,(IN2)+              ;FIRST CHARACTER WILL BE BLANK ALWAYS.
    2223 012770 020027  023420                  CMP     IN1,#10000.             ;IS IT GREATER THEN 9999.?
    2224 012774 103037                          BHIS    ASCIIG                  ;YES. DO SOMETHING SPECIAL.
    2225 012776 112721  000040                  MOVB    #' ,(IN2)+              ;NO. JUST INSERTA BLANK.
    2226 013002 005046                          CLR     -(SP)                   ;AND REMEMBER TO DELETE LEADING ZEROS.
    2227 013004 020027  000144          ASCIIL: CMP     IN1,#100.               ;IS IT GREATER THAN 99?
    2228 013010 002444                          BLT     ASCIID                  ;NO! NO DIVIDE IS NECESSARY.
    2229 013012 010003                          MOV     IN1,RET2                ;GREATER THAN 99. DIVIDE.
    2230 013014 005002                          CLR     RET1                    ;CLEAR HIGH ORDER WORD OF AC-MQ.
    2231 013016 012700  000144                  MOV     #100.,IN1               ;DIVIDE BY 100.
    2232 013022 004767  176130                  JSR     PC,DIVTWO               ;DIVIDE NOW.
    2233 013026 006303                          ASL     RET2                    ;NOW LOOK UP ANSWER IN TABLE.
    2234 013030 062703  024026'                 ADD     #TENTAB,RET2            ;TWO BYTES WHICH COMPOSE NEXT TWO DIGITS.
    2235 013034 004767  000072          ASCIIB: JSR     PC,ASCDO                ;INSERT FIRST.
    2236 013040 004767  000066                  JSR     PC,ASCDO                ;INSERT SECOND.
    2237 013044 010203                          MOV     RET1,RET2               ;GET THE REMAINDER NOW.
    2238 013046 006303                          ASL     RET2
    2239 013050 062703  024026'                 ADD     #TENTAB,RET2            ;AND MAKE IT A GOOD ADDRESS.
    2240 013054 004767  000052                  JSR     PC,ASCDO                ;AND DO THE NEXT TWO DIGITS.
    2241 013060 010716                          MOV     PC,(SP)                 ;BUT MAKE SURE WE GET A GOOD ZERO.
    2242 013062 004767  000044                  JSR     PC,ASCDO
    2243 013066 062706  000002                  ADD     #2,SP                   ;BUMP THE STACK NOW.
    2244 013072 000207                          RTS     PC                      ;AND RETURN.
    2245 013074 010746                  ASCIIG: MOV     PC,-(SP)                ;UPDATE LEADING ZERO FLAG TO NO DELETE.
    2246 013076 112721  000060                  MOVB    #'0,(IN2)+              ;INSERT IT INTO THE BUFFER NOW.
    2247 013102 020027  023420          ASCIIM: CMP     IN1,#10000.             ;SEE IF IT'S STILL ABOVE 9999.
    2248 013106 103736                          BLO     ASCIIL                  ;NO. EXIT
    2249 013110 105261  177777                  INCB    -1(IN2)                 ;YES CHANGE DIGIT AND UPDATE.
    2250 013114 162700  023420                  SUB     #10000.,IN1
    2251 013120 000770                          BR      ASCIIM                  ;AND LOOP TILL DONE.
    2252 013122 010002                  ASCIID: MOV     IN1,RET1                ;SMALL NUMBER. SET UP REMAINDER.
    2253 013124 012703  024026'                 MOV     #TENTAB,RET2            ;AND ADDRESS FOR THE FIRST 0.
    2254 013130 000741                          BR      ASCIIB                  ;AND INSERT THEM NOW.
    2255 013132 005766  000002          ASCDO:  TST     2(SP)                   ;INSERT ANYTHING?
    2256 013136 001011                          BNE     ASCDBP                  ;YES.
    2257 013140 121327  000060                  CMPB    (RET2),#'0              ;NO. IS THIS CHARACTER A ZERO?
    2258 013144 001004                          BNE     ASCDO1                  ;NO. FIRST GOOD CHARACTER.
    2259 013146 112721  000040                  MOVB    #' ,(IN2)+              ;STILL ZERO. INSERT A BLANK.
    2260 013152 005203                          INC     RET2                    ;AND BOP INPUT POINTER.
    2261 013154 000207                          RTS     PC                      ;AND RETURN NOW.
    2262 013156 010666  000002          ASCDO1: MOV     SP,2(SP)                ;GOOD CHARACTER. CLEAR ZERO FLAG.
    2263 013162 112321                  ASCDBP: MOVB    (RET2)+,(IN2)+          ;AND MOVE OVER THE CHARACTER NOW.
    2264 013164 000207                          RTS     PC                      ;AND THEN RETURN.
    2265                                        .PAGE
    2266                                ;
    2267                                ;               THIS ROUTINE WILL CONVERT A SIGNED NUMBER TO AN ASCII
    2268                                ;               STRING ACCORDING TO THE RULES USED IN "ASCII".
    2269                                ;
    2270 013166 005700                  SASCII: TST     IN1                     ;GET THE SIGN OF THE INPUT.
    2271 013170 100275                          BPL     ASCII                   ;IF POSITIVE, NOTHING SPECIAL.
    2272 013172 005400                          NEG     IN1                     ;ELSE NEGATE IT.
    2273 013174 004767  177564                  JSR     PC,ASCII                ;AND CONVERT IT.
    2274 013200 010100                          MOV     IN2,IN1                 ;MOV BACK LAST POINTER.
    2275 013202 122740  000040          SASCIL: CMPB    #' ,-(IN1)              ;AND LOOK FOR THE FIRST BACKWARD BLANK.
    2276 013206 001375                          BNE     SASCIL
    2277 013210 112710  000055                  MOVB    #'-,(IN1)               ;WHEN FOUND, CHANGE IT.
    2278 013214 000207                          RTS     PC                      ;AND RETURN NOW.
