     175                                ;                          START OF THE SYSTEM.
     176 000216 000005                  START:  RESET                           ; DO A FEW HEAVY RESETS
     177 000220 000005                          RESET
     178                                ;
     179                                ;               INSTALL THE NEW VECTORS
     180                                ;
     181 000222 012767  001014' 000024'         MOV     #POWERF,24              ; PWR FAIL VECTOR
     182 000230 012767  000340  000026'         MOV     #340,26
     183 000236 012767  001010' 000060'         MOV     #KBDINT,60              ; KEYBOARD
     184 000244 012767  000340  000062'         MOV     #340,62
     185 000252 012767  011614' 000100'         MOV     #TIMER,100              ; LINE CLOCK
     186 000260 012767  000300  000102'         MOV     #300,102
     187 000266 012767  011740' 000320'         MOV     #DISPLY,320             ; VT-11
     188 000274 012767  000200  000322'         MOV     #200,322
     189 000302 012767  012114' 000324'         MOV     #LIGHT,324
     190 000310 012767  000200  000326'         MOV     #200,326
     191 000316 012767  001064' 000330'         MOV     #DBUSE,330
     192 000324 012767  000340  000332'         MOV     #340,332
     193                                ;
     194                                ;               DISPLAY THE STARTING MESSAGE (ONCE)
     195                                ;
     196 000332 012706  040132'                 MOV     #STACK,SP
     197 000336 012767  040134' 172000'         MOV     #STARTM,DPC
     198 000344 012767  000100  177560'         MOV     #100,177560             ; ENABLE KBD INTERRUPTS
     199 000352 012767  000100  177546'         MOV     #100,LKS                ; ENABLE LINE CLOCK
     200 000360 004767  011270                  JSR     PC,DELAY                ; WAIT 10 SECS AND GET STARTED
     201 000364 000012                          .WORD   10.
     202                                ;
     203                                ;               ONCE STARTED, ALL RESTARTS OCCUR HERE
     204                                ;
     205 000366 012700  014054'         RESTAR: MOV     #MOONST,IN1             ;NOW SET THE MOON AREA TO ALL DISTOP'S
     206 000372 012701  017776'                 MOV     #MOONEN,IN2             ;FOLLOWED BY A ZERO. GET LOC TO GET COUNT.
     207 000376 160001                          SUB     IN1,IN2                 ;AND GET # OF BYTES.
     208 000400 006201                          ASR     IN2                     ;GET NUMBER OF WORDS TO CLEAR.
     209 000402 006201                          ASR     IN2                     ;GET NUMBER OF DOUBLE WORDS TO CLEAR.
     210 000404 012720  173400          RESTL1: MOV     #DISTOP,(IN1)+          ;PUT IN THE DISPLAY STOP INSTRUCTIONS NOW.
     211 000410 005020                          CLR     (IN1)+
     212 000412 005301                          DEC     IN2
     213 000414 003373                          BGT     RESTL1                  ;AND LOOP TILL DONE.
     214 000416 005067  177776'                 CLR     STATUS                  ;CLEAR CPU STUFF.
     215 000422 012706  040132'                 MOV     #STACK,SP               ;SET UP THE STACK POINTER NOW.
     216 000426 012700  000506'                 MOV     #INIT,IN1               ;INITIALIZE THE SYSTEM NOW.
     217 000432 012001                  STARTL: MOV     (IN1)+,IN2              ;PICK UP NEXT COMMAND.
     218 000434 001402                          BEQ     IDLE                    ;ZERO. ALL DONE.
     219 000436 012011                          MOV     (IN1)+,(IN2)            ;DO COMMAND NOW.
     220 000440 000774                          BR      STARTL                  ;AND LOOP FOREVER.
     221                                ;
     222                                ;               THIS IS THE MAIN WAIT POINT. IT IS
     223                                ;               ACTIVATED IN THE NORMAL RUNNING MODE.
     224                                ;               SUBROUTINE "EIDLE" CAN BE CALLED WHEN
     225                                ;               IT IS TIME TO BLAST OFF FROM THE MOON
     226                                ;               AFTER GETTING A HAMBURGER.
     227                                ;
     228 000442 004767  000002          IDLE:   JSR     PC,EIDLE                ;WAIT FOR AN EVENT.
     229 000446 000775                          BR      IDLE                    ;AND LOOP FOREVER.
     230 000450 000001                  EIDLE:  WAIT                            ;WAIT FOR AN INTERUPT TO OCCUR.
     231 000452 026727  177372  000005  1$:     CMP     TICKS,#5                ;WAIT FOR CLOCK ON THE 40AND 45
     232 000460 002774                          BLT     1$
     233 000462 016700  177362                  MOV     TICKS,IN1               ;PICK UP THE NUMBER OF CLOCK TICKS NOW.
     234 000466 001406                          BEQ     EXIDLE                  ;IF NONE, JUST EXIT.
     235 000470 005067  177354                  CLR     TICKS                   ;ELSE RESET THE LITTLE TICK COUNTER.
     236 000474 010067  177352                  MOV     IN1,CLOCK               ;AND THEN PUT THE # OF TICKS AWAY FOR CALCULATIONS.
     237 000500 004767  001770                  JSR     PC,SHOWSP               ;DO CALCULATIONS.
     238 000504 000207                  EXIDLE: RTS     PC                      ;AND THEN RETURN TO CALLER.
     239                                        .PAGE
