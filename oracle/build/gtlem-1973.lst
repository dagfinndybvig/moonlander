     403                                ;       THIS ROUTINE FIGURES OUT THE ACCELERATION OF THE SHIP AND
     404                                ;       THE AMOUNT OF FUEL REMAINING.
     405                                ;
     406 001402 005767  176436          ROCKET: TST     FUEL                    ;SEE HOW MUCH FUEL WE HAVE ON BOARD NOW.
     407 001406 001521                          BEQ     ROCKOFF                 ;NONE. TURN OFF THE ENGINE.
     408 001410 016700  176424                  MOV     PERTRS,IN1              ;PICK UP THE PERCENT THROTTLE NOW.
     409 001414 012701  024404                  MOV     #MAXTRS,IN2             ;GET THE MAXIMUM THRUST NOW.
     410 001420 004767  007070                  JSR     PC,MULTWO               ;GET PER CENT * MAXTHRUST.
     411 001424 012700  000144                  MOV     #100.,IN1               ;GET %*MAXIMUM THRUST /100.
     412 001430 004767  007522                  JSR     PC,DIVTWO
