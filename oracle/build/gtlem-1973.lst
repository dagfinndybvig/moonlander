     499                                ;       THIS ROUTINE GETS THE SINE AND COSINE FROM THE TABLES.
     500                                ;
     501 002106 016700  175670          TRIG:   MOV     ANGLE,IN1               ;PICK UP THE ANGLE NOW.
     502 002112 100007                          BPL     TRIG2                   ;POSITIVE. SEE IF >180.
     503 002114 020027  177514          TRIG1:  CMP     IN1,#-180.              ;NEGATIVE. SEE IF BELOW -180.
     504 002120 003012                          BGT     TRIG3                   ;>-180. IT'S OK.
     505 002122 062700  000550                  ADD     #360.,IN1               ;TOO SMALL. FUDGE IT AND LOOP.
     506 002126 100007                          BPL     TRIG3                   ;IF STILL NEGATIVE. ELSE IT'S OK.
     507 002130 000771                          BR      TRIG1
     508 002132 020027  000264          TRIG2:  CMP     IN1,#180.               ;POSITIVE. SEE IF IT'S >180.
     509 002136 003403                          BLE     TRIG3                   ;NOPE. IT'S OK.
     510 002140 162700  000550                  SUB     #360.,IN1               ;DECREMENT BY ONE REVOLUTION
     511 002144 100772                          BMI     TRIG2                   ;AND LOOP IF IT'S STILL TO BIG.
     512 002146 010067  175630          TRIG3:  MOV     IN1,ANGLE               ;AND NOW SAVE IT AWAY AGAIN.
     513 002152 100002                          BPL     TRIG4                   ;CONVERT TO A GOOD COMPASS NOTATION.
     514 002154 062700  000550                  ADD     #360.,IN1               ;ELSE WRAP AROUND ONCE.
     515 002160 006300                  TRIG4:  ASL     IN1                     ;SHIFT IT LEFT BECAUSE IT'S NECESSARY.
     516 002162 016067  030736' 175616          MOV     SINTAB(IN1),SINANG      ;NOW GET THE NECESSARY CONSTANTS.
