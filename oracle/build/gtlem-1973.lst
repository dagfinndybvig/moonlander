    2006 011706 003374                          BGT     DELAY1
    2007 011710 000001                  DELAY2: WAIT                            ;WAIT FOR AN INTERUPT TO OCCUR.
    2008 011712 004767  000654                  JSR     PC,DIAL                 ;WHILE WAITING, DISPLAY THE USER'S DATA.
    2009 011716 020167  166132                  CMP     IN2,TIME                ;CHECK THE TIMES NOW.
    2010 011722 101372                          BHI     DELAY2
    2011 011724 062716  000002                  ADD     #2,(SP)                 ;UPDATE THE RETURN PC NOW.
    2012 011730 005702                          TST     RET1                    ;TEST SIGN OF THE WAIT.
    2013 011732 100727                          BMI     DVOKX                   ;IF NEGATIVE, THEN RETURN.
    2014 011734 000167  166426                  JMP     RESTART                 ;ELSE RESTART THE SYSTEM.
    2015                                        .PAGE
