    1270 006412 012725  106120                  MOV     #SETSVM,(TEMP2)+        ;AFTER STORING Y POS, SET GRAPH PLOT MODE.
    1271 006416 012700  024362'                 MOV     #TERAIN,IN1             ;POINTER TO THE TERAIN.
    1272 006422 062700  000010          DRAW1L: ADD     #8.,IN1                 ;POSITION TO THE NEXT Y.
    1273 006426 011004                          MOV     (IN1),TEMP
