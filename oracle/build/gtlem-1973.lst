    2041 012044 012007                  DSUBRT: MOV     (IN1)+,PC               ;GO TO SUBROUTINE NOW.
    2042 012046 012001                  GOTSUB: MOV     (IN1)+,IN2              ;PICK UP OLD DPC
    2043 012050 000750                          BR      DISRT                   ;AND RESTART AND CONTINUE.
