     548 002316 005502                          ADC     RET1                    ;AND DON'T FORGET THE CARRY.
     549 002320 004767  006632                  JSR     PC,DIVTWO               ;ACTUAL DISTANCE COVERED.
     550 002324 005726                          TST     (SP)+                   ;RECALL OLD SIGN OF VELOCITY.
     551 002326 100001                          BPL     WH4
