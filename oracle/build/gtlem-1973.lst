    1224                                ;       THESE ROUTINE WILL INSERT OR CHANGE A LUNAR
    1225                                ;       FEATURE OR WILL RETRIEVE IT'S VALUE.
    1226                                ;
    1227 006222 010446                  PUTFET: MOV     TEMP,-(SP)              ;SAVE TEMPORARY NOW.
