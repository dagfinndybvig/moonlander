    1192 006076 100003                          BPL     MOVM1                   ;TO THE RIGHT.
    1193 006100 012705  005300                  MOV     #DEC,TEMP2              ;ELSE MAKE THE X GO THE OTHER WAY.
    1194 006104 005403                          NEG     RET2                    ;AND SET THE COUNTER TO GO DOWN.
    1195 006106 010567  000052          MOVM1:  MOV     TEMP2,PALSYI            ;SAVE AWAY THE GENERATED INSTRUCTION NOW.
    1196 006112 005005                          CLR     TEMP2                   ;CLEAR THE DELTA Y ADD NOW.
    1197 006114 005702                          TST     RET1                    ;NOW GET THE AMOUNT OF THE DELTA "Y".
