    1201 006124 100002                          BPL     MOVJX                   ;IF UP, ALL IS WELL,
    1202 006126 005403                          NEG     RET2                    ;ELSE NEGATE COUNT AND THE
    1203 006130 005405                          NEG     TEMP2                   ;AND THE DELTA Y ADD.
