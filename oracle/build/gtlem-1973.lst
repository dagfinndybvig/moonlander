     638 002736 005767  175100                  TST     THRUST                  ;NOW SEE ABOUT THE ROCKET FLAME.
     639 002742 003410                          BLE     NOFLAM                  ;NO THRUST=NO FLAME.
     640 002744 012700  032612'                 MOV     #FLAMIN,IN1             ;THIS IS WHERE TO LEAVE THE FLAME.
     641 002750 004767  176744                  JSR     PC,FLAME                ;GO DRAW THE FLAME NOW.
     642 002754 012767  032612' 027322          MOV     #FLAMIN,FSUBC           ;AND TURN ON THE FLAME AGAIN.
     643 002762 000402                          BR      YSFLAM                  ;AND LEAVE FLAME ON.
     644 002764 005067  027314          NOFLAM: CLR     FSUBC                   ;IF NO THRUST, TURN OF ROCKET.
     645 002770 016704  175062          YSFLAM: MOV     BIGXCT,TEMP             ;PICK UP X POSITION NOW.
     646 002774 100466                          BMI     OFFLFT                  ;WE'RE OFF TO THE LEFT.
     647 002776 020427  000012                  CMP     TEMP,#10.
     648 003002 003463                          BLE     OFFLFT                  ;WE ARE STILL OFF TO THE LEFT.
     649 003004 020427  001572                  CMP     TEMP,#890.
     650 003010 002065                          BGE     OFFRGT                  ;SEE IF WE ARE TOO FAR TO THE RIGHT.
     651 003012 016704  175014                  MOV     VERDIS,TEMP             ;WE SEEM TO BE OK. HOW ABOUT HEIGHT.
     652 003016 100523                          BMI     CLSEUP                  ;IF MINUS, GO INTO CLOSEUP MODE.
     653 003020 020427  060650                  CMP     TEMP,#25000.            ;IF OFF TOP, GIVE MESSAGE.
     654 003024 002064                          BGE     OFFTOP
     655 003026 020427  000702                  CMP     TEMP,#450.              ;SEE IF WE SHOULD MAGNIFY.
     656 003032 003515                          BLE     CLSEUP                  ;YES. MAGNIFY.
     657 003034 016767  175016  027224          MOV     BIGXCT,SHOWX            ;ELSE ESTABLISH THE Y COORDINATE.
     658 003042 006204                          ASR     TEMP                    ;NOW SCALE DOWN THE VERTICAL DISTANCE.
     659 003044 006204                          ASR     TEMP
     660 003046 006204                          ASR     TEMP
     661 003050 006204                          ASR     TEMP
     662 003052 006204                          ASR     TEMP                    ;32 FEET PER RASTOR AT THIS RANGE.
     663 003054 062704  000053                  ADD     #43.,TEMP               ;UPDATE
     664 003060 010467  027204                  MOV     TEMP,SHOWY
     665 003064 005767  175042                  TST     MOON                    ;IS MOON DRAWN.
     666 003070 001404                          BEQ     SHWMN1                  ;YES.
     667 003072 004767  003260                  JSR     PC,DRAWM1               ;NO.
     668 003076 005067  175030                  CLR     MOON                    ;RESET FLAG.
     669 003102 004767  007464          SHWMN1: JSR     PC,DIAL                 ;DISPLAY THE DIALS NOW.
     670 003106 016704  174760                  MOV     RADARY,TEMP
     671 003112 162704  000020                  SUB     #16.,TEMP               ;FIX FOR CENTER OF THE SHIP.
     672 003116 100014                          BPL     SHWOUT                  ;IT'S OK.
     673 003120 012700  001200                  MOV     #640.,IN1               ;NOT OK. WE'VE CRASHED. BIG DISTORTION.
     674 003124 004767  003660                  JSR     PC,ALTER                ;ALTER MOON NOW.
     675 003130 010667  174776                  MOV     SP,MOON                 ;INDICATE THAT WE'VE ALTERED THE MOON.
     676 003134 004767  003216                  JSR     PC,DRAWM1               ;NOW REDRAW IT.
     677 003140 005067  174766                  CLR     MOON                    ;AND REMEMBER THAT WE'VE REDRAWN IT.
     678 003144 004767  003714                  JSR     PC,EXPLOD               ;GIVE AN EXPLOSION.
     679 003150 000207                  SHWOUT: RTS     PC                      ;AND RETURN NOW.
