     859                                ;
     860                                ;               ROUTINE WHICH FIGURES OUT WHAT TO DO NOW.
     861                                ;
     862 004130 004767  006436          INTEL:  JSR     PC,DIAL                 ;DISPLAY USER'S DATA NOW.
     863 004134 016705  173732                  MOV     RADARY,TEMP2            ;PICK UP ALTITUDE NOW.
     864 004140 100451                          BMI     INTELM                  ;IT'S NEGATIVE. FIGURE OUT SOMETHING SPECIAL.
     865 004142 020527  000003                  CMP     TEMP2,#3.               ;ARE WE CLOSE.
     866 004146 003451                          BLE     VERYLOW                 ;WE CERTAINLY ARE.
     867 004150 016704  173650                  MOV     VERVEL,TEMP             ;NOT TOO LOW. GET VELOCITY NOW.
     868 004154 020427  176650                  CMP     TEMP,#-600.             ;SEE IF <=60 FPS
     869 004160 002425                          BLT     AHAH                    ;YES. IS HE SCREWED UP.
     870 004162 020427  177324                  CMP     TEMP,#-300.             ;HOW ABOUT 30 FPS
     871 004166 002426                          BLT     AHAH2                   ;HE'S NOT TOO SCREWED UP <YET!>
     872 004170 020427  177552                  CMP     TEMP,#-150.             ;HOW ABOUT FIFTEEN FPS.
     873 004174 002427                          BLT     AHAH3                   ;GIVE ANOTHER MESSAGE.
     874 004176 026727  026112  020414'         CMP     SYSMES,#N2FAST          ;WAS A NOT TOO FAST MESSAGE THE
     875 004204 001002                          BNE     AHAHC                   ;ONE ISSUED. NO.
     876 004206 005067  026102                  CLR     SYSMES                  ;YES. DELETE IT NOW.
     877 004212 016700  173646          AHAHC:  MOV     INDEXL,IN1              ;PICK UP FEATURE INDEX NOW.
     878 004216 010046                          MOV     IN1,-(SP)               ;PUSH DESIRED ITEM ONTO STACK.
     879 004220 004767  002070                  JSR     PC,GETFET               ;GET THE FEATURE NOW.
     880 004224 012601                          MOV     (SP)+,IN2               ;AND POP THE ITEM OFF THE STACK.
     881 004226 006301                          ASL     IN2                     ;MULTIPLY IT BY TWO.
     882 004230 000171  007756'                 JMP     @AHTAB(IN2)             ;WE'VE GOT IT NOW.
     883 004234 012767  020256' 026052  AHAH:   MOV     #VFAST,SYSMES           ;GIVE A VERY FAST MESSAGE NOW.
     884 004242 000763                          BR      AHAHC                   ;AND DO SOMETHING ELSE.
     885 004244 012767  020332' 026042  AHAH2:  MOV     #FAST,SYSMES            ;GIVE A FAST MESSAGE.
     886 004252 000757                          BR      AHAHC
     887 004254 012767  020414' 026032  AHAH3:  MOV     #N2FAST,SYSMES          ;GIVE A "TAKE IT EASY MESSAGE".
     888 004262 000753                          BR      AHAHC
     889 004264 020527  177766          INTELM: CMP     TEMP2,#-10.
     890 004270 003446                          BLE     DEAD                    ;TOO FAR DOWN. HE'S DEAD.
     891 004272 005067  173536          VERYLO: CLR     PERCNT                  ;TURN OFF FUEL NOW.
     892 004276 012767  000702  016350          MOV     #BARBY,LPBARY           ;AND INIDCATE IT TO HIM.
     893 004304 005067  025774                  CLR     FSUBC                   ;TERMINATE FLAMES.
     894 004310 005067  026010                  CLR     DUSTON                  ;AND THE DUST.
     895 004314 005705                          TST     TEMP2                   ;GET ALTITUDE NOW.
     896 004316 001401                          BEQ     VD                      ;WE'RE DOWN.
     897 004320 100334                          BPL     AHAHC                   ;IF POSITIVE, LOOK FOR FEATURES.
     898 004322 016704  173476          VD:     MOV     VERVEL,TEMP             ;PICK UP THE VERTICAL VELOCITY NOW.
     899 004326 020427  176650                  CMP     TEMP,#-600.             ;SEE IF GREATER THAN 60 FPS.
     900 004332 003425                          BLE     DEAD                    ;YES. SPLAT
     901 004334 020427  177324                  CMP     TEMP,#-300.             ;HOW ABOUT 30FPS
     902 004340 003417                          BLE     CRIPPLED                ;YES. HE'S CRIPLLED.
     903 004342 020427  177552                  CMP     TEMP,#-150.             ;HOW ABOUT 15FPS
     904 004346 003411                          BLE     ROUGH                   ;IT'S A ROUGH ONE.
     905 004350 020427  177660                  CMP     TEMP,#-80.              ;HOW ABOUT 8FPS.
     906 004354 003403                          BLE     GOOD                    ;IT'S A GOOD ONE.
     907 004356 012700  020520'                 MOV     #GREATM,IN1             ;ISSUE GREAT MESSAGE
     908 004362 000426                          BR      MAYBE                   ;AND NOW CHECK HORIZONTAL VELOCITY.
     909 004364 012700  020570'         GOOD:   MOV     #GOODM,IN1              ;A GOOD LANDING.
     910 004370 000423                          BR      MAYBE
     911 004372 012700  020646'         ROUGH:  MOV     #ROUGHM,IN1             ;A ROUGH LANDING.
     912 004376 000420                          BR      MAYBE
     913 004400 012700  020720'         CRIPPL: MOV     #CRIPM,IN1              ;CRIPPLED. GIVE THAT MESSAGE.
     914 004404 000415                          BR      MAYBE
     915 004406 012767  021024' 025700  DEAD:   MOV     #DEADM,SYSMES           ;ISSUE THE DEAD MESSAGE NOW.
     916 004414 012700  000040          QUICK:  MOV     #32.,IN1                ;ALTER THE SURFACE NOW.
     917 004420 004767  002364                  JSR     PC,ALTER
