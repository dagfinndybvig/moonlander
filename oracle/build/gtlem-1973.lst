    1231 006234 006366  000006                  ASL     6(SP)                   ;LEFT BYTE. SHIFT OVER THE VALUE.
    1232 006240 006366  000006                  ASL     6(SP)
    1233 006244 006366  000006                  ASL     6(SP)
    1234 006250 006366  000006                  ASL     6(SP)
