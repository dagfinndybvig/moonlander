     710                                ;
     711                                ;               THIS ROUTINE WILL DRAW THE CLOSEUP PICTURES OF
     712                                ;               THE MOON, WHEN THEY BECOME NECESSARY. RETURN GOES
     713                                ;               BACK TO IDLE VIA THE OLD PC ON THE STACK
     714                                ;               <OR IT SHOULD, ANYWAY.>.
     715                                ;
     716 003266 026716  174640          CLSEUP: CMP     MOON,(SP)               ;SEE IF WE HAVE THE MOON IN SIGHT.
     717 003272 001554                          BEQ     CLSEC1                  ;YES.
     718 003274 016700  174556                  MOV     BIGXCT,IN1              ;NO. GET CURRENT RASTOR POSITION.
     719 003300 162700  000011                  SUB     #9.,IN1                 ;NOW SET A GOOD LEFT EDGE.
     720 003304 010067  174550          CLSEFG: MOV     IN1,LEFTEDGE            ;LEFT EDGE ESTABLISHED NOW.
     721 003310 006300                          ASL     IN1                     ;NOW CONVERT EDGE TO FEET.
     722 003312 006300                          ASL     IN1
     723 003314 006300                          ASL     IN1
     724 003316 006300                          ASL     IN1
     725 003320 006300                          ASL     IN1
     726 003322 162700  053600                  SUB     #22400.,IN1
     727 003326 010067  174530                  MOV     IN1,LEFEET              ;AND SAVE THAT AWAY.
     728 003332 004767  004050                  JSR     PC,DRAWM2               ;DRAW A CLOSE-UP OF THE MOON NOW.
     729 003336 011667  174570                  MOV     (SP),MOON               ;SET FLAG TO INDICATE WE HAVE DONE SO.
     730 003342 016700  174462                  MOV     HORDIS,IN1              ;PICK UP THE HORIZONTAL POSITION NOW.
     731 003346 166700  174510                  SUB     LEFEET,IN1              ;GET FEET FROM LEFT EDGE OF SCREEN.
     732 003352 010003                  CLSEOK: MOV     IN1,RET2                ;NOW GET RASTOR POSITION (3/2)
     733 003354 006300                          ASL     IN1
     734 003356 060003                          ADD     IN1,RET2
     735 003360 006203                          ASR     RET2                    ;(3/2) OF FEET=RASTOR<X>
     736 003362 010367  026700                  MOV     RET2,SHOWX              ;AND SAVE IT AWAY NOW.
     737 003366 005002                          CLR     RET1                    ;NOW CONVERT THIS POSITION TO A GOOD.
     738 003370 012700  000060                  MOV     #48.,IN1                ;NOW CONVERT BACK TO A TERAIN INDEX.
     739 003374 004767  005556                  JSR     PC,DIVTWO               ;DO THE DIVISION NOW.
     740 003400 066703  174454                  ADD     LEFTEDGE,RET2           ;MAKE INTO A TERAIN AND FEATURE INDEX.
     741 003404 010367  174454                  MOV     RET2,INDEXL             ;SAVE AWAY INDEX TO LEFT POSTION OF SHIP.
     742 003410 006303                          ASL     RET2                    ;MULTIPLY BY TWO FOR THE TERAIN.
     743 003412 010304                          MOV     RET2,TEMP               ;SAVE IT FOR A SECOND.
     744 003414 012700  000060                  MOV     #48.,IN1                ;NOW FIGURE OUT HOW MUCH SHIP IS TO LEFT
     745 003420 160200                          SUB     RET1,IN1                ;OR RIGHT OF CENTER OF TERAIN. USE DIVISION REMAINDER.
     746 003422 010205                          MOV     RET1,TEMP2              ;SAVE THAT AWAY.
     747 003424 016401  024362'                 MOV     TERAIN(TEMP),IN2        ;PICK UP TERAIN NOW.
     748 003430 004767  005440                  JSR     PC,SGNMUL               ;MULTIPLY IT OUT NOW.
     749 003434 010346                          MOV     RET2,-(SP)              ;SAVE FOR A SECOND NOW.
     750 003436 010500                          MOV     TEMP2,IN1               ;RECALL REMAINDER NOW. DO RIGHT EDGE OF "TERRAIN".
     751 003440 016401  024364'                 MOV     TERAIN+2(TEMP),IN2      ;OTHER HEIGHT.
     752 003444 004767  005424                  JSR     PC,SGNMUL               ;MULTIPLY THEM OUT.
     753 003450 005002                          CLR     RET1                    ;NOW SET UP DIVIDE. THIS WILL CONVERT
     754 003452 012700  000060                  MOV     #48.,IN1                ;TERAIN HEIGHT*48 TO DISPLAY FUDGED HEIGHT.
     755 003456 062603                          ADD     (SP)+,RET2              ;OLD FUDGED WEIGHTED HEIGHT.
     756 003460 100005                          BPL     CLSEF1                  ;AVERAGE IS POSITIVE.
     757 003462 005403                          NEG     RET2                    ;AVERAGE IS NEGATIVE.
     758 003464 004767  005466                  JSR     PC,DIVTWO               ;DO THE DIVIDE NOW.
     759 003470 005403                          NEG     RET2                    ;AND NEGATE THE ANSWER.
     760 003472 000402                          BR      CLSEF2
     761 003474 004767  005456          CLSEF1: JSR     PC,DIVTWO
     762 003500 010304                  CLSEF2: MOV     RET2,TEMP               ;MOVE OVER HEIGHT FOR DFAKE TO USE.
     763 003502 006203                          ASR     RET2                    ;NOW CONTINUING FUDING TERRAIN BY KNOWN STANDARDS.
     764 003504 006203                          ASR     RET2
     765 003506 010367  174356                  MOV     RET2,AVERY              ;SAVE AWAY AVERAGE TERAIN HEIGHT.
     766 003512 004767  004300                  JSR     PC,DFAKE                ;GET ACTUAL RASTER HEIGHT ABOVE THE MOON.
     767 003516 010467  174344                  MOV     TEMP,AVERT              ;SAVE IT AWAY NOW.
     768 003522 016700  174304                  MOV     VERDIS,IN1              ;PICK UP THE DISTANCE NOW.
     769 003526 010003                          MOV     IN1,RET2                ;PREPARE TO CONVERT TO RASTORS.
     770 003530 006303                          ASL     RET2                    ; THE OLD 3/2 GAMBIT.
     771 003532 060003                          ADD     IN1,RET2
     772 003534 006203                          ASR     RET2
     773 003536 062703  000027                  ADD     #23.,RET2               ;TO CONVERT TO VIEWING RASTORS.
     774 003542 010367  026522                  MOV     RET2,SHOWY              ;SAVE IT AWAY NOW.
     775 003546 062767  000030  026514          ADD     #24.,SHOWY              ;EXCEPT FOR THE FUDGE.
     776 003554 160403                          SUB     TEMP,RET2               ;GET # OF RASTORS TO GO.
     777 003556 010304                          MOV     RET2,TEMP               ;MOVE BACK OVER.
     778 003560 100001                          BPL     CLSEF3                  ;IF POSITIVE, ALL IS WELL.
     779 003562 005403                          NEG     RET2                    ;ELSE NEGATE IT NOW.
     780 003564 005002                  CLSEF3: CLR     RET1                    ;PREPARE TO DO THE DIVIDE.
     781 003566 012700  000003                  MOV     #3.,IN1                 ;MAKE IT THREE HALFS.
     782 003572 006303                          ASL     RET2
     783 003574 004767  005356                  JSR     PC,DIVTWO
     784 003600 005704                          TST     TEMP                    ;GET BACK THE ORIGINAL SIGN NOW.
     785 003602 100001                          BPL     CLSEF4
     786 003604 005403                          NEG     RET2
     787 003606 010367  174260          CLSEF4: MOV     RET2,RADARY             ;AND THIS IS THE RADAR HEIGHT.
     788 003612 004767  000312                  JSR     PC,INTEL                ;FIGURE OUT IF ANYTHING GREAT IS TO HAPPEN.
     789 003616 004767  001172                  JSR     PC,DUST                 ;AND ALSO IF WE SHOULD SHOW DUST.
     790 003622 000207                  AHNONE: RTS     PC                      ;AND WHEN DONE, RETURN NOW.
     791 003624 016700  174200          CLSEC1: MOV     HORDIS,IN1              ;MOON ALREADY BEING DISPLAYED.
     792 003630 166700  174226                  SUB     LEFEET,IN1              ;SEE IF IT'S STILL ON THE SCREEN.
     793 003634 020027  000036                  CMP     IN1,#30.                ;TO CLOSE TO LEFT?
     794 003640 003407                          BLE     CLOL                    ;YES. SHIFT TO RIGHT.
     795 003642 020027  001104                  CMP     IN1,#580.               ;TOO CLOSE TO LEFT
     796 003646 002641                          BLT     CLSEOK                  ;NOPE. DISPLAY AS IS.
     797 003650 016700  174202                  MOV     BIGXCT,IN1              ;SHIFT EVERYTHING LEFT NOW.
     798 003654 005300                          DEC     IN1
     799 003656 000612                          BR      CLSEFG                  ;SHOULD BE POIFECT.
     800 003660 016700  174172          CLOL:   MOV     BIGXCT,IN1              ;SHIFT EVERYTHING RIGHT IF TOO CLOSE TO THE LEFT.
     801 003664 162700  000021                  SUB     #17.,IN1
     802 003670 000605                          BR      CLSEFG                  ;FUDGE IT NOW.
     803                                        .PAGE
     804                                ;
     805                                ;               GENERAL INTELIGENCE SECTION...
     806                                ;               THIS CODE GOES HERE SO THAT IT MAY BE
     807                                ;               REFERENCED BY SIMPLE BRANCH INSTRUCTIONS
     808                                ;               FROM THE MAIN SECTION "INTEL".
     809                                ;
     810 003672 005727  003674'         AHMAC:  TST     #MACON                  ;OVER MACDONALD'S. SEE IF DRAWN.
     811        003674                          .=.-2                           ;DEFINE MACON AS BEING HERE.
     812 003674 000000                  MACON:  .WORD   0                       ;AND INITIALIZE IT TO ZERO.
     813 003676 001751                          BEQ     AHNONE                  ;NO, NOT DRAWN. EXIT NOW.
     814 003700 020527  000036                  CMP     TEMP2,#30.              ;YES. SEE HOW CLOSE WE ARE.
     815 003704 003346                          BGT     AHNONE                  ;NOT TOO CLOSE. ALL IS WELL.
     816 003706 005027  003710'                 CLR     #MACTHR                 ;TOO CLOSE. WE'VE CRASHED INTO IT.
     817        003710                          .=.-2                           ;AND LIKEWISE DEFINE THE MAC DESTROYED
     818 003710 003710'                 MACTHR: .WORD   MACTHR                  ;FLAG AS STILL HAVING MACDONALDS.
     819 003712 012767  022106' 026374          MOV     #MACDED,SYSMES          ;TELL HIM WE'VE CRASHED INTO IT.
     820 003720 000167  000470                  JMP     QUICK                   ;AND KILL HIM OFF.
     821 003724 020527  000017          AHROCK: CMP     TEMP2,#15.              ;ARE WE TOO LOW OVER THE ROCK?
     822 003730 003334                          BGT     AHNONE                  ;NOPE.
     823 003732 026727  174066  176650          CMP     VERVEL,#-600.           ;GREATER THAN CRASH SPEED?
     824 003740 003465                          BLE     GODEAD                  ;YES. HE'S DEAD.
     825 003742 012767  021524' 026344          MOV     #ROCKMS,SYSMES          ;START DISPLAYING THE ROCK MESSAGE NOW.
     826 003750 005067  026320                  CLR     SHIPDP                  ;STOP DISPLAYING THE SHIP NOW.
     827 003754 004767  003104                  JSR     PC,EXPLOD               ;EXPLOD NOW
     828 003760 020527  000032          AHSP1:  CMP     TEMP2,#26.              ;TOO HIGH?
     829 003764 003316                          BGT     AHNONE                  ;IT'S ALRIGHT.
     830 003766 020427  176650                  CMP     TEMP,#-600.             ;TOO FAST.
     831 003772 003450                          BLE     GODEAD
     832 003774 012767  021600' 026312          MOV     #OLDMS,SYSMES           ;DISPLAY THE OLD SHIP MESSAGE.
     833 004002 012746  000003                  MOV     #3,-(SP)                ;SET UP A LEFT SHIP
     834 004006 005767  174006                  TST     HORVEL                  ;GET HORIZONTAL VELOCITY.
     835 004012 100401                          BMI     AHSP1M                  ;DIRECTION OK.
     836 004014 005216                          INC     (SP)                    ;MAKE IT RIGHT TILTING.
     837 004016 010046                  AHSP1M: MOV     IN1,-(SP)               ;PUSH THE INDEX ONTO THE STACK.
     838 004020 004767  002176                  JSR     PC,PUTFET               ;PLACE IN FEATURE TABLE NOW.
     839 004024 162767  000020  026236          SUB     #16.,SHOWY              ;BRING DOWN THE OLD SHIP.
     840 004032 004767  003350                  JSR     PC,DRAWM2               ;REDRAW THE MOON NOW.
     841 004036 004767  003022                  JSR     PC,EXPLOD               ;EXPLOD THE SHIP NOW.
     842 004042 020527  000032          AHFLG:  CMP     TEMP2,#26.              ;ARE WE TOO HIGH
     843 004046 003265                          BGT     AHNONE                  ;YEP.
     844 004050 005767  173766                  TST     THRUST                  ;ENGINE ON?
     845 004054 001662                          BEQ     AHNONE                  ;NOPE. EXIT.
     846 004056 005046                          CLR     -(SP)                   ;CLEAR THE FLAG NOW.
     847 004060 010046                          MOV     IN1,-(SP)
     848 004062 004767  002134                  JSR     PC,PUTFET               ;CLEAR INDICATOR FLAG NOW.
     849 004066 012767  021672' 026220          MOV     #FLAGMS,SYSMES          ;GIVE THE FLAG MESSAGE NOW.
     850 004074 004767  003306                  JSR     PC,DRAWM2               ;REDRAW THE MOON NOW.
     851 004100 000650                          BR      AHNONE                  ;AND CONTINUE CHECKING CRAP.
     852 004102 020527  000021          AHOLDS: CMP     TEMP2,#17.              ;SEE IF ON CRASHED SHIP.
     853 004106 003245                          BGT     AHNONE                  ;NOPE.
     854 004110 020427  176650                  CMP     TEMP,#-600.             ;SEE IF TOO FAST.
     855 004114 003534                  GODEAD: BLE     DEAD                    ;ELSE DEAD.
     856 004116 012767  022000' 026170          MOV     #OLDTLT,SYSMES          ;GIVE MESSAGE.
     857 004124 004767  002734                  JSR     PC,EXPLOD               ;AND EXPLOD NOW.
