    1983                                ;               THIS IS THE CLOCK INTERUPT ROUTINE.
    1984                                ;
    1985 011614 052767  000100  177546' TIMER:  BIS     #100,LKS                ;JUST MAKE SURE CLOCK IS STILL GOING.
    1986 011622 005267  166222                  INC     TICKS                   ;UPDATE CLOCKS.
