    1994                                ;
    1995                                ;                                       THIS IS THE DELAY ROUTINE.
    1996                                ;                       IT WILL WAIT "N" SECONDS BEFORE RESTARTING THE SYSTEM.
    1997                                ;
    1998 011654 012767  173400  011020  DELAY:  MOV     #DISTOP,LPSW            ;IF DELAYED CALLED, TURN OFF LOW FUEL MESSAGE.
    1999 011662 017600  000000                  MOV     @0(SP),IN1              ;PICK UP THE TIME.
    2000 011666 016701  166162                  MOV     TIME,IN2                ;GET CURRENT TIME.
    2001 011672 010002                          MOV     IN1,RET1                ;MOVE OVER TIME REQUESTED.
    2002 011674 100001                          BPL     DELAY1                  ;IF POSITIVE, IT'S ALRIGHT.
    2003 011676 005400                          NEG     IN1                     ;ELSE NEGATE IT NOW.
    2004 011700 062701  000062          DELAY1: ADD     #CLKFRQ,IN2             ;CALCULATE FUTURE TIME
