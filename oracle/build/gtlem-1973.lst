     102                                ;
     103                                ;       MISC INFORMATION.
     104                                ;       ---- ------------
     105                                ;               ALL VELOCITIES ARE SIGNED AND STORED IN TENTHS OF FEET PER SECOND.
     106                                ;               ALL ACCELERATIONS ARE 500 TIMES ACTUAL.
     107                                ;               THE HORIZONTAL AND VERTICAL DISTANCE IS IN FEET (SIGNED).
     108                                ;               THE FUEL IS IN TENTHS OF POUNDS.
     109                                ;               WEIGHT OF THE CRAFT IS IN POUNDS, AS IS THRUST.
     110                                ;               ORIENTATION OF THE SHIP IS STRICTLY COMPASS (I.E. 
     111                                ;               ZERO DEGREES IS AT THE TOP, 90 TO THE RIGHT, ETC.
     112                                ;                       M A I N   D A T A   A R E A .
     113                                ;
     114 000000 000000                  TURN:   .WORD   0                       ;PRESENT RATE OF TURN AS SELECTED BY USER.
     115 000002 000000                  ANGLE:  .WORD   0                       ;ANGLE CURRENTLY BEING USED FOR TRIG CALCULATIONS.
     116 000004 000000                  ANGLER: .WORD   0                       ;REMAINDER OF ANGLE FOR TURNING.
     117 000006 000000                  SINANG: .WORD   0                       ;SINE OF THAT ANGLE
     118 000010 000000                  COSANG: .WORD   0                       ;COSINE OF THAT ANGLE.
     119 000012 000000                  ACCEL:  .WORD   0                       ;CURRENT ACCEL OF SHIP CAUSED BY ROCKET.
     120 000014 000000                  HORACC: .WORD   0                       ;CURRENT HORIZONTAL ACCELERATION.
     121 000016 000000                  VERACC: .WORD   0                       ;CURRENT VERTICAL ACCELERATION (INCLUDING G).
     122 000020 000000                  HORVEL: .WORD   0                       ;CURRENT HORIZONTAL VELOCITY>
     123 000022 000000                  HORREM: .WORD   0                       ;REMAINDER OF HORIZONTAL VELOCITY AFTER DIVIDING.
     124 000024 000000                  VERVEL: .WORD   0                       ;CURRENT VERTICAL VELOCTIY.
     125 000026 000000                  VERREM: .WORD   0                       ;REMAINDER OF VERTICAL VELOCITY AFTER DIVIDING.
     126 000030 000000                  HORDIS: .WORD   0                       ;CURRENT HORIZONTAL DISTANCE.
     127 000032 000000                  VERDIS: .WORD   0                       ;CURRENT VERTICAL DISTANCE.
     128 000034 000000                  PERCNT: .WORD   0                       ;% OF THRUST FROM LIGHT BAR.
     129 000036 000000                  OLDPER: .WORD   0                       ;PREVIOUS % TO SAVE USELESS DISPLAY CALCULATION.
     130 000040 000000                  PERTRS: .WORD   0                       ;% THRUST THE USER IS REQUESTING.
     131 000042 000000                  THRUST: .WORD   0                       ;ACTUAL THRUST DELIVERED.
     132 000044 000000                  FUEL:   .WORD   0                       ;TENTHS OF # OF LBS (EARTH) OF FUEL REMIANING.
     133 000046 000000                  WEIGHT: .WORD   0                       ;CURRENT EARTH WEIGHT OF SHIP.
     134 000050 000000                  TICKS:  .WORD   0                       ;# OF TICKS. MOVED OVER TO CLOCK.
     135 000052 000000                  CLOCK:  .WORD   0                       ;# OF CLOCK TICKS SINCE LAST CALCULATION.
     136 000054 000000                  TIME:   .WORD   0                       ;ACCUMULATION OF "CLOCK". I.E. TOD.
     137 000056 000000                  BIGXCT: .WORD   0                       ;PRESENT POSITION OF SHIP (X RASTOR).
     138 000060 000000                  LEFTED: .WORD   0                       ;LEFT EDGE OF SCREEN FOR CLOSEUP WORK (DELTA X).
     139 000062 000000                  LEFEET: .WORD   0                       ;DISTANCE FROM LANDING THAT LEFTEDGE IS DURING CLOSEUP.
     140 000064 000000                  INDEXL: .WORD   0                       ;INDEX FOR FEATURE JUST TO LEFT OF SHIP.
     141 000066 000000                  AVERT:  .WORD   0                       ;AVERAGE RASTOR HEIGHT OF TERAIN.
     142 000070 000000                  AVERY:  .WORD   0                       ;AVERAGE Y HEIGHT OF THE TERRAIN.
     143 000072 000000                  RADARY: .WORD   0                       ;AVERAGE RADAR HEIGHT ABOVE THE TERRAIN.
     144 000074 000000                  LASTX:  .WORD   0                       ;USED TO KEEP TRACK OF WHERE DRAW WAS WORKING.
     145 000076 000000                  LASTY:  .WORD   0                       ;SAME FOR Y.
     146 000100 000000                  LOWY:   .WORD   0                       ;LOWER LIMIT TO SHOW INVISIBLE VECTOR.
     147 000102 000000                  LOWEST: .WORD   0                       ;LOWEST Y COORDINATE OF PRESENT SCREEN FIGURE.
     148 000104 000000                  SAVEY:  .WORD   0                       ;LOWEST Y OF LAST DRAWN SHIP.
     149 000106 000000                  FRAND:  .WORD   0                       ;RANDOMIZER WORD FOR ROCKET FLICKER.
     150 000110 000000                  FSHIFT: .WORD   0                       ;X SHIFTER FOR FLAME.
     151 000112 000000                  FINT:   .WORD   0                       ;INTENSITY OF FLAME.
     152 000114 000000                  FLINE:  .WORD   0                       ;LINE TYPE FOR FLAME.
     153 000116 000000                  SHIPTP: .WORD   0                       ;FLIP-FLOP TO DETERMINE WHICH BUFFER
     154                                                                        ;THE USER IS DISPLAYING SHIP FROM.
     155 000120 000000                  DNUM:   .WORD   0                       ;CURRENT PICTURE WE ARE DISPALYING.
     156 000122 000216'                 DSTACK: .WORD   STACKD                  ;CURRENT DISPLAY STACK POINTER.
     157 000124 000000                  LPFLG1: .WORD   0                       ;CURRENT ADDRESS OF VALUE TO BE DISPLAYED.
     158 000126 000000                  OLDHIT: .WORD   0                       ;PREVIOUS LIGHT PEN ADDRESS COUNTER TO
     159 000130 000000                  HITCNT: .WORD   0                       ;AVOID SPURIOUS HITS.
     160 000132 000132'                 MOON:   .WORD   .                       ;CURRENT STATUS OF PICTURE OF MOON.
     161 000134 000000                  DRAWCT: .WORD   0                       ;COUNTER FOR DRAWING THE MOON.
     162 000136 000000                  DRAWTY: .WORD   0                       ;LOCAL COUNTER FOR CHANGING THE INTENSITY OF
     163 000140 000000                  DRAWTZ: .WORD   0                       ;THE SURFACE OF THE MOON.
     164 000142 000000                  DINT:   .WORD   0
     165 000144 000000                  DTYPE:  .WORD   0
     166 000146 000000                  DFUDGE: .WORD   0                       ;ADDITIONAL MOON FUDGING FOR CLOSEUP.
     167 000150 000000                  XTYPE:  .WORD   0                       ;THIS IS THE RANDOMIZING WORD FOR
     168 000152 000000                  RADIUS: .WORD   0                       ;THE EXPLOSION, AND THE BLAST RADIUS.
     169 000154 000154'                 DUSTX:  .WORD   .                       ;A RANDOM WORD FOR GENERATING DUST.
     170        000216                          .=.+40                          ; -- RESERVE 40 OCTAL WORDS FOR STACK
     171                                STACKD:                                 ;MAKE SURE THAT THERE IS ENOUGH SPACE FOR IT.
     172                                        .PAGE
