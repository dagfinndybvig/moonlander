    1242 006312 000207                          RTS     PC                      ;RETURN NOW.
    1243 006314 010446                  GETFET: MOV     TEMP,-(SP)              ;SAVE A SCRATCH REGISTER NOW.
    1244 006316 016604  000004                  MOV     4(SP),TEMP              ;PICK UP THE INDEX NOW.
    1245 006322 006204                          ASR     TEMP                    ;BYTE ADDRESS IT.
    1246 006324 116404  030025'                 MOVB    FEATUR(TEMP),TEMP       ;PICK UP THE FEATUR NOW.
    1247 006330 103004                          BCC     GETDUN                  ;IF RIGHT BYTE, NO SHIFTING IS NECESSARY.
    1248 006332 006204                          ASR     TEMP                    ;ELSE SHIFT IT OVER.
    1249 006334 006204                          ASR     TEMP
    1250 006336 006204                          ASR     TEMP
    1251 006340 006204                          ASR     TEMP
    1252 006342 042704  177360          GETDUN: BIC     #177360,TEMP            ;JUST RETURN 4 BITS NOW.
    1253 006346 010466  000004                  MOV     TEMP,4(SP)
    1254 006352 012604                          MOV     (SP)+,TEMP              ;MOVE OVER ANSWER AND RESTORE SCRATCH
    1255 006354 000207                          RTS     PC                      ;REGISTER AND EXIT.
