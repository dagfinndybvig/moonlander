    1257                                ;
    1258                                ;               THIS ROUTINE WILL "DRAW" THE MOON FROM THE TABLE OF Y VALUES.
    1259                                ;
    1260 006356 004767  000114          DRAWM1: JSR     PC,DRAWMC               ;SET UP COMMON CRAP.
    1261 006362 016704  015774                  MOV     TERAIN,TEMP             ;PICK UP FIRST Y POS.
    1262 006366 006204                          ASR     TEMP                    ;DIVIDE BY 32
    1263 006370 006204                          ASR     TEMP
    1264 006372 006204                          ASR     TEMP
    1265 006374 006204                          ASR     TEMP
    1266 006376 006204                          ASR     TEMP
    1267 006400 062704  000027                  ADD     #23.,TEMP
    1268 006404 010425                          MOV     TEMP,(TEMP2)+
