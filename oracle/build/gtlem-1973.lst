    1288                                ;
    1289                                ;               THIS ROUTINE WILL ITIALIZE CERTAIN
    1290                                ;               REGISTERS, SAVE REGISTERS AND DO OTHER CRAP NECESSARY
    1291                                ;               FOR THE MOON DRAWING ROUTINES TO WORK.
    1292                                ;
    1293 006476 010246                  DRAWMC: MOV     RET1,-(SP)
    1294 006500 010346                          MOV     RET2,-(SP)
    1295 006502 010046                          MOV     IN1,-(SP)
    1296 006504 010146                          MOV     IN2,-(SP)
    1297 006506 010446                          MOV     TEMP,-(SP)
    1298 006510 012767  000341  171416          MOV     #225.,DRAWCT            ;NUMBER OF VECTORS TO DRAW.
    1299 006516 005067  023612                  CLR     MOONGO                  ;TURN OFF DRAWING OF MOON.
    1300 006522 005067  175146                  CLR     MACON                   ;SET FLAG TO "NO MACDONALD'S ON SCREEN".
    1301 006526 012705  014054'                 MOV     #MOONST,TEMP2           ;SET UP THE POINTER NOW.
    1302 006532 012725  114124                  MOV     #114124,(TEMP2)+        ;PLOT POINT MODE.
    1303 006536 012725  170240                  MOV     #170240,(TEMP2)+        ;SET STATUS MODE.
    1304 006542 005025                          CLR     (TEMP2)+                ;SET X POSITION TO ZERO NOW.
    1305 006544 000176  000012                  JMP     @10.(SP)                ;AND RETURN NOW.
    1306 006550 011666  000014          DRAWRS: MOV     (SP),12.(SP)            ;MOVE OVER RETURN ADDRESS.
    1307 006554 012604                          MOV     (SP)+,TEMP              ;THROW AWAY TOP ITEM.
    1308 006556 012604                          MOV     (SP)+,TEMP              ;AND RESTORE THE REGISTERS.
    1309 006560 012601                          MOV     (SP)+,IN2
    1310 006562 012600                          MOV     (SP)+,IN1
    1311 006564 012603                          MOV     (SP)+,RET2
    1312 006566 012602                          MOV     (SP)+,RET1
    1313 006570 000207                          RTS     PC                      ;AND RETURN NOW.
    1314                                        .PAGE
    1315                                ;
    1316                                ;               THIS ROUTINE WILL INSERT ONE "Y" POINT INTO THE
    1317                                ;               MOON LIST. IT WILL RANDOMIZE THE LINE TYPE AND INTENSITY
    1318                                ;
    1319 006572 012746  001000          DRAWIC: MOV     #1000,-(SP)             ;MAKE THE VECTOR INVISIBLE FOR NOW.
    1320 006576 020427  002000                  CMP     TEMP,#1024.             ;SEE IF IT'S TOO BIG.
    1321 006602 103405                          BLO     DRAWI1                  ;NOT TOO BIG.
    1322 006604 012704  001777                  MOV     #1023.,TEMP             ;TOO BIG, SET TO TOP, AND TURN OFF
    1323 006610 020467  171262                  CMP     TEMP,LASTY              ;IS IT STILL ON TOP?
    1324 006614 001410                          BEQ     DRAWI3                  ;YES. DON'T DRAW THE MOUNTAIN.
    1325 006616 005704                  DRAWI1: TST     TEMP                    ;SEE IF VALUE IS LESS THAN ZERO.
    1326 006620 100004                          BPL     DRAWI2                  ;YES.
    1327 006622 005004                          CLR     TEMP                    ;NO IT ISN'T.
    1328 006624 005767  171246                  TST     LASTY                   ;WAS LAST RESULT 0?
    1329 006630 001402                          BEQ     DRAWI3                  ;YES. DO NOT PUT ON VISIBLE BIT.
    1330 006632 052716  040000          DRAWI2: BIS     #40000,(SP)             ;TURN ON VISIBLE BIT.
    1331 006636 005367  171274          DRAWI3: DEC     DRAWTY                  ;SEE WHAT TYPE OF INTENSITY
    1332 006642 100033                          BPL     DRWIN                   ;AND LINE TYPE IS REQUIRED, IF ANY.
    1333 006644 005267  171270                  INC     DRAWTZ                  ;COUNTER OVERFLOWED. CHANGE TYPE.
    1334 006650 042767  177774  171262          BIC     #-4,DRAWTZ
    1335 006656 005267  171256                  INC     DRAWTZ
    1336 006662 016767  171252  171246          MOV     DRAWTZ,DRAWTY           ;RESET BIGGY AND LITTLY.
    1337 006670 062767  001200  171244          ADD     #1200,DINT              ;RANDOMIZE INTENSITY AND TYPE.
    1338 006676 042767  176177  171236          BIC     #176177,DINT
    1339 006704 005267  171234                  INC     DTYPE
    1340 006710 042767  177774  171226          BIC     #-4,DTYPE
    1341 006716 016715  171220                  MOV     DINT,(TEMP2)            ;CREATE NEW PLOT POINT INSTRUCTION.
    1342 006722 056715  171216                  BIS     DTYPE,(TEMP2)
    1343 006726 052725  106004                  BIS     #106004,(TEMP2)+        ;GRAPH Y WITH BLANK INTENSITY'S AND TYPES.
    1344 006732 166704  171140          DRWIN:  SUB     LASTY,TEMP              ;GET THE DELTA Y.
    1345 006736 100010                          BPL     DRWINP                  ;FIX UP DIRECTION OF VECTOR.
    1346 006740 005404                          NEG     TEMP
    1347 006742 042704  177700                  BIC     #-100,TEMP              ;REMOVE CRAP NOW.
    1348 006746 160467  171124                  SUB     TEMP,LASTY              ;UPDATE PREVIOUS Y NOW.
    1349 006752 052704  000100                  BIS     #100,TEMP
    1350 006756 000404                          BR      DRWINQ
    1351 006760 042704  177700          DRWINP: BIC     #-100,TEMP              ;CLEAN IT UP.
    1352 006764 060467  171106                  ADD     TEMP,LASTY              ;AND UPGRADE PREVIOUS Y NOW.
    1353 006770 052604                  DRWINQ: BIS     (SP)+,TEMP              ;MAKE IT A GOOD INSTRUCTION NOW.
    1354 006772 010425                          MOV     TEMP,(TEMP2)+           ;AND SAVE IT AWAY NOW.
    1355 006774 005367  171134                  DEC     DRAWCT                  ;DECREMENT MASTER COUNTER.
    1356 007000 003002                          BGT     DRAWRR                  ;NORMAL RETURN.
    1357 007002 062716  000002                  ADD     #2,(SP)                 ;END RETURN.
    1358 007006 000207                  DRAWRR: RTS     PC                      ;AND EXIT NOW.
