     414 001440 010301                          MOV     RET2,IN2
     415 001442 016700  176404                  MOV     CLOCK,IN1               ;PICK UP NUMBER OF CLOCK TICKS.
     416 001446 004767  007042                  JSR     PC,MULTWO
     417 001452 012700  002734                  MOV     #CLKFDG,IN1             ;PICK UP FREQUENCY*25.
     418 001456 004767  007474                  JSR     PC,DIVTWO               ;APPROX. 250LBS FUEL PER LB THRUST.
     419 001462 166703  176356                  SUB     FUEL,RET2               ;NOW SUBTRACT OFF REMAINING FUEL.
     420 001466 100405                          BMI     FUELOK                  ;IF NEGATIVE, THEN THE FUEL IS OK.
     421 001470 005003                          CLR     RET2                    ;ELSE MAKE SURE TOTAL IS ZERO.
     422 001472 012767  173400  021202          MOV     #DISTOP,LPSW            ;STOP THE LOW FUEL MESSAGE NOW.
     423 001500 000414                          BR      FUELKO                  ;HE'S GOT NONE LEFT.
     424 001502 005403                  FUELOK: NEG     RET2                    ;GET FUEL LEFT
     425 001504 005767  021172                  TST     LPSW                    ;SEE IF FUEL IS ALREADY LOW.
     426 001510 001410                          BEQ     FUELKO                  ;IT IS.
     427 001512 020327  003720                  CMP     RET2,#2000.             ;SEE IF UNDER 200 POUNDS.
     428 001516 002005                          BGE     FUELKO                  ;NO. STILL OK.
     429 001520 005067  021156                  CLR     LPSW                    ;ELSE CLEAR THE SWITCH NOW.
     430 001524 052767  000000  172002'         BIS     #0,DSR                  ;AND RING THE BELL <ONCE ONLY>
     431 001532 010367  176306          FUELKO: MOV     RET2,FUEL               ;AND SAVE IT AWAY.
     432 001536 005002                          CLR     RET1                    ;NOW DIVIDE BY 10 TO CONVERT
     433 001540 012700  000012                  MOV     #10.,IN1                ;TENTHS OF POUNDS TO POUNDS.
     434 001544 004767  007406                  JSR     PC,DIVTWO               ;DO DIVISION NOW.
     435 001550 062703  033734                  ADD     #EMPTY,RET2             ;ADD IN EMPTY WEIGHT OF SHIP.
     436 001554 010367  176266                  MOV     RET2,WEIGHT             ;AND SAVE AWAY NOW.
     437 001560 016700  176256                  MOV     THRUST,IN1              ;FIGURE OUT ACCELERATION NOW.
     438 001564 012701  037327                  MOV     #G1,IN2
     439 001570 004767  006720                  JSR     PC,MULTWO
     440 001574 010400                          MOV     TEMP,IN1                ;NOW DIVIDE BY WEIGHT.
     441 001576 004767  007354                  JSR     PC,DIVTWO
     442 001602 010367  176204                  MOV     RET2,ACCEL              ;AND SAVE THIS AWAY. A=TRS*G/W
     443 001606 010300                          MOV     RET2,IN1
