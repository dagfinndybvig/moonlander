     299                                ;
     300                                ;                       POWER FAIL ROUTINES HERE.
     301                                ;
     302 001014 012767  000216' 177100  POWERF: MOV     #STACKD,DSTACK          ;SET UP ALL THE STACKS NOW.
     303 001022 012767  012052' 177166          MOV     #DTOP,STACKD
     304 001030 005067  177064                  CLR     DNUM
     305 001034 012767  013364' 172000'         MOV     #ITEME1,DPC             ;THE DISPLAY IS GOING NOW.
     306 001042 012767  000100  177546'         MOV     #100,LKS                ;SO IS THE CLOCK.
     307 001050 012706  040132'                 MOV     #STACK,SP               ;NOW SO IS THE PROGRAM.
     308 001054 005067  177776'                 CLR     STATUS
     309 001060 000167  177356                  JMP     IDLE                    ;AND REENTER.
     310                                ;
     311                                ;                       DISPLAY BUS ERROR ROUTINES.
     312                                ;
     313 001064 005067  177030          DBUSE:  CLR     DNUM                    ;RECYCLE DISPLAY TO THE TOP OF THE LIST.
     314 001070 010046                          MOV     IN1,-(SP)               ;MAKE IT LOOK LIKE A NORMAL INTERUPT.
     315 001072 010146                          MOV     IN2,-(SP)
     316 001074 012701  013240'                 MOV     #DITEM1,IN2
     317 001100 000167  010774                  JMP     DTOPOK                  ;AND REENTER IT NOW.
     318                                        .PAGE
     319                                ;
     320                                ;       THIS ROUTINE WILL DRAW THE SHIP RELATIVE TO IT'S CENTER.
     321                                ;       THE ANGLES HAVE ALREADY BEEN GOTTEN FROM SOMEWHERE
     322                                ;       ELSE AND HAVE BEEN LEFT IN COSANG AND SINANG. IN ADDITION,
     323                                ;       IN1 POINTS TO THE COMMANDS ON HOW TO DRAW THE SHIP, AND IN2
     324                                ;       POINTS TO WHERE TO LEAVE THEM.
     325                                ;       COMMAND LIST OF THE THE FORM:
     326                                ;               "ADDRESS OF ROUTINE"
     327                                ;               "EXTRA DATA, IF NEEDED".
     328                                ;       IF IT'S A DATA POINT TO BE ROTATED, THEN THE NEXT WORD
     329                                ;       HAS THE X AND Y VALUES AS SEPARATE BYTES. THE X VALUE
     330                                ;       IS THE BYTE ON THE RIGHT....... REMEMBER THAT.
     331                                ;
     332 001104 010004                  DRAW:   MOV     IN1,TEMP                ;MOVE OVER THE INPUT LIST POINTER.
     333 001106 010105                          MOV     IN2,TEMP2               ;AND THE OUTPUT LIST POINTER.
     334 001110 005067  176760                  CLR     LASTX                   ;SET TO CENTER OF OBJECT.
     335 001114 005067  176756                  CLR     LASTY
     336 001120 012767  077777  176754          MOV     #77777,LOWEST           ;SET UP LOWEST POINT WE HAVE DRAWN SO FAR.
     337 001126 012407                  DRAWLP: MOV     (TEMP)+,PC              ;GO TO FIRST INSTRUCTION.
     338 001130 005046                  DRAWIS: CLR     -(SP)                   ;DRAW INVISIBLE SHORT.
     339 001132 004767  000154                  JSR     PC,DRAWRT               ;ROTATE NEXT SET OF POINTS.
     340 001136 000416                          BR      DRAWSC                  ;AND THEN INSERT THEM INTO LIST.
     341 001140 012746  040000          DRAWVS: MOV     #40000,-(SP)            ;DRAW VISIBLE SHORT.
     342 001144 004767  000142                  JSR     PC,DRAWRT               ;ROTATE RETURNS X IN RET1, Y IN RET2.
     343 001150 026767  176722  176722          CMP     LASTY,LOWY              ;SEE IF THIS LINE SHOULD BE DRAWN.
     344 001156 002002                          BGE     DRAWV1                  ;YEP.
     345 001160 005016                          CLR     (SP)                    ;NOPE. CLEAR OUT DISPLAY BIT.
     346 001162 000404                          BR      DRAWSC
