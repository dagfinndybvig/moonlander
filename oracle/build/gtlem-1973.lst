    1275 006432 006204                          ASR     TEMP
    1276 006434 006204                          ASR     TEMP
    1277 006436 006204                          ASR     TEMP
    1278 006440 006204                          ASR     TEMP
    1279 006442 062704  000027                  ADD     #23.,TEMP               ;SCALE IT AROUND NOW.
    1280 006446 004767  000120                  JSR     PC,DRAWIC               ;INSERT ONE Y CO-ORD
    1281 006452 000763                          BR      DRAW1L                  ;AND LOOP TILL DONE.
    1282 006454 012725  173400                  MOV     #DISTOP,(TEMP2)+        ;AND FINALLY TERMINATE THE LIST
    1283 006460 005015                          CLR     (TEMP2)
