    1210 006156 005303                          DEC     RET2                    ;ELSE DECREMENT THE COUNTER.
    1211 006160 003366                          BGT     MOVLUP                  ;AND LOOP TILL DONE.
    1212 006162 000207                          RTS     PC                      ;AND THEN RETURN.
    1213 006164 000000                  PALSYI: .WORD   0                       ;EITHER AN INC OR DEC 'IN1'
    1214 006166 000207                          RTS     PC                      ;AND THEN RETURN WITH IN1 UPDATED.
    1215 006170 032767  000007  171656  PALSYW: BIT     #7,TIME                 ;WAIT FOR NONE MULTIPLE OF 8.
    1216 006176 001774                          BEQ     PALSYW
    1217 006200 004767  004366                  JSR     PC,DIAL                 ;AND DISPLAY THE USER'S INFORMATION NOW.
    1218 006204 032767  000007  171642  PALSYV: BIT     #7,TIME                 ;AND THEN WAIT FOR 8 MORE <OR LESS>
    1219 006212 001374                          BNE     PALSYV
