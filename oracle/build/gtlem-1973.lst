    2022 011750 017701  172000'                 MOV     @DPC,IN2                ;FIND OUT WHY WE STOPPED.
    2023 011754 001433                          BEQ     DSUBRT                  ;DISPLAY SUBROUTINE RETURN.
    2024 011756 016740  172000'                 MOV     DPC,-(IN1)              ;SUBROUTINE CALL. PUSH RETURN DPC ON STACK.
    2025 011762 062710  000002                  ADD     #2,(IN1)                ;AND FUDGE PAST POINTER.
    2026 011766 012740  012046'                 MOV     #GOTSUB,-(IN1)          ;AND PUSH RETURN ADDRESS ONTO STACK.
    2027 011772 021127  173400          DISRT:  CMP     (IN2),#DISTOP           ;SEE IF WHERE HE WANTS TO START IS
    2028 011776 001013                          BNE     DISRST                  ;ANOTHER SUBROUTINE CALL.
    2029 012000 005761  000002                  TST     2(IN2)                  ;IF IT IS, THEN FIGURE OUT WHETHER
    2030 012004 001417                          BEQ     DSUBRT                  ;TO RETURN OR GO DOWN ONE LEVEL.
    2031 012006 010140                          MOV     IN2,-(IN1)              ;PUSH NEXT DPC ONTO STACK.
    2032 012010 062710  000004                  ADD     #4,(IN1)                ;AND FUDGE IT UP A BIT.
    2033 012014 012740  012046'                 MOV     #GOTSUB,-(IN1)          ;PUT ADDRESS ONTO STACK.
    2034 012020 016101  000002                  MOV     2(IN2),IN2              ;UPDATE NEW PC NOW.
    2035 012024 000762                          BR      DISRT                   ;AND LOOP AGAIN.
    2036 012026 010067  166070          DISRST: MOV     IN1,DSTACK              ;SAVE THE STACK NOW.
    2037 012032 010167  172000'                 MOV     IN2,DPC                 ;START THE DISPLAY GOING NOW.
    2038 012036 012601                          MOV     (SP)+,IN2               ;RESTORE SAVED REGISTERS.
    2039 012040 012600                          MOV     (SP)+,IN1
