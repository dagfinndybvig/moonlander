     682                                ;               OFF SCREEN ROUTINES GO HERE......
     683                                ;
     684 003152 012700  000015          OFFLFT: MOV     #13.,IN1                ;PICK UP A NEW X NOW.
     685 003156 012701  017776'                 MOV     #LFTMSG,IN2             ;AND PICK UP A MESSAGE NOW.
     686 003162 000410                          BR      OFFCOM                  ;AND DO THE COMMON ROUTINES NOW.
     687 003164 012700  001567          OFFRGT: MOV     #887.,IN1               ;A RIGHT X VALUE.
     688 003170 012701  020036'                 MOV     #RGTMSG,IN2
     689 003174 000403                          BR      OFFCOM                  ;SAME CRAP.
     690 003176 010400                  OFFTOP: MOV     TEMP,IN1                ;PRESENT X VALUE.
     691 003200 012701  020144'                 MOV     #TOPMSG,IN2             ;TOP MESSAGE.
     692 003204 006300                  OFFCOM: ASL     IN1                     ;GET A NEW HORDISTANCE.
     693 003206 006300                          ASL     IN1
     694 003210 006300                          ASL     IN1
     695 003212 006300                          ASL     IN1
     696 003214 006300                          ASL     IN1
     697 003216 162700  053600                  SUB     #22400.,IN1
     698 003222 010067  174602                  MOV     IN1,HORDIS              ;SET DISTANCE.
     699 003226 010167  027062                  MOV     IN2,SYSMES              ;SET MESSAGE NOW.
     700 003232 005067  174606                  CLR     FUEL                    ;TURN OFF FUEL NOW.
     701 003236 005067  174556                  CLR     HORVEL                  ;CLEAR SIDEWAYS MOTION.
     702 003242 016703  174564                  MOV     VERDIS,RET2             ;PICK UP VERTICAL DISTANCE NOW.
     703 003246 006203                          ASR     RET2                    ;DIVIDE BY 4 TO GET A REASONALBE SPEED.
     704 003250 006203                          ASR     RET2
     705 003252 100401                          BMI     OFFCMD                  ;IF GOING DOWN, WE ARE OK.
     706 003254 005403                          NEG     RET2                    ;ELSE MAKE US GO DOWN.
     707 003256 010367  174542          OFFCMD: MOV     RET2,VERVEL             ;AND SAVE IT AWAY NOW.
     708 003262 000167  177206                  JMP     SHOWSP                  ;AND RELOOP AND REDISPLAY SHIP NOW.
