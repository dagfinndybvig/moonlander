    1237 006264 142764  000017  030025' FETRGT: BICB    #17,FEATUR(TEMP)        ;CLEAR OUT THE RIGHT BYTE NOW.
    1238 006272 156664  000006  030025' PUTCOM: BISB    6(SP),FEATUR(TEMP)      ;INSERT THE BYTE NOW.
    1239 006300 012604                          MOV     (SP)+,TEMP              ;RESTORE THE REGISTER NOW.
    1240 006302 011666  000004                  MOV     (SP),4(SP)
