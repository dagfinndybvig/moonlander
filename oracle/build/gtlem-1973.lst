    2017                                ;       THIS IS THE START OF THE DISPLAY SECTION. PLEASE BE MERICFUL.
    2018                                ;
    2019 011740 010046                  DISPLY: MOV     IN1,-(SP)               ;COMES HERE ON AN INTERUPT.
    2020 011742 010146                          MOV     IN2,-(SP)
