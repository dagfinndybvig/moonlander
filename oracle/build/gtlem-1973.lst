    1360                                ;
    1361                                ;               ALTER WILL ALTER THE FACE OF THE MOON. IN1
    1362                                ;               CONTAINS A NUMBER TO BE USED IN ALTERING IT.
    1363                                ;
    1364 007010 016701  171042          ALTER:  MOV     BIGXCT,IN2              ;PICK UP PRESENT INDEX.
    1365 007014 010104                          MOV     IN2,TEMP                ;WORK BOTH FORWARD AND BACKWARD.
    1366 007016 006301                          ASL     IN2
    1367 007020 062701  024362'                 ADD     #TERAIN,IN2
    1368 007024 012746  000003                  MOV     #3,-(SP)                ;INDICATE A CRASHED SHIP.
    1369 007030 012105                          MOV     (IN2)+,TEMP2            ;PICK UP Y.
    1370 007032 010103                          MOV     IN2,RET2
    1371 007034 161105                          SUB     (IN2),TEMP2             ;FIGURE OUT WHICH WAY TO TILT SHIP.
    1372 007036 100401                          BMI     ALERTP                  ;LEAVE TILTED TO LEFT.
    1373 007040 005216                          INC     (SP)
    1374 007042 010446                  ALERTP: MOV     TEMP,-(SP)              ;PUSH THE INDEX ONTO THE STACK.
    1375 007044 004767  177152                  JSR     PC,PUTFET               ;AND PUT AWAY THE FEATURE.
    1376 007050 160021                  ALERTL: SUB     IN1,(IN2)+              ;NOW ALTER BOTH WAYS.
    1377 007052 160043                          SUB     IN1,-(RET2)
    1378 007054 006200                          ASR     IN1                     ;DIVIDE BY TWO.
    1379 007056 005400                          NEG     IN1                     ;AND NEGATE IT.
    1380 007060 001373                          BNE     ALERTL                  ;AND LOOP TILL DONE.
    1381 007062 000207                          RTS     PC                      ;ELSE RETURN NOW.
    1382                                        .PAGE
    1383                                ;
    1384                                ;               THIS SECTION WILL CAUSE THE SKIP TO
    1385                                ;               EXPLODE ON THE SCREEN BY SHOOTING OUT A SERIES OF
    1386                                ;               "DOTS" FOR A GIVEN PERIOD OF TIME.
    1387                                ;
    1388 007064 005067  171062          EXPLOD: CLR     RADIUS                  ;SET THE RADIUS TO ZERO.
    1389 007070 005067  023210                  CLR     FSUBC                   ;TURN OFF THE ROCKET NOW.
    1390 007074 005067  023224                  CLR     DUSTON                  ;TURN OFF THE DUST, IF ANY.
    1391 007100 052767  000000  172002'         BIS     #0,DSR                  ;"RING THE BELL".
    1392 007106 012705  032714'         EXPLD1: MOV     #EXLIST,TEMP2           ;GET POINTER TO WHERE TO SHOW EXPLOSION.
    1393 007112 016704  171032                  MOV     XTYPE,TEMP              ;PICK UP RANDOMIZING WORD NOW.
    1394 007116 005204                          INC     TEMP                    ;AND JUST PLAY WITH YOURSELF FOR A WHILE.
    1395 007120 000304                          SWAB    TEMP
    1396 007122 006004                          ROR     TEMP
    1397 007124 061504                          ADD     (TEMP2),TEMP            ;ADD IN OLD COMMAND.
    1398 007126 042704  176177                  BIC     #176177,TEMP            ;CLEAR OUT CRAP NOW.
    1399 007132 052704  116120                  BIS     #116120,TEMP            ;MAKE IT A GOOD COMMAND NOW.
    1400 007136 010425                          MOV     TEMP,(TEMP2)+           ;AND INSERT IT INTO THE BUFFER.
    1401 007140 004767  000066                  JSR     PC,EXGEN                ;GENERATE SOME SMOKE NOW.
    1402 007144 052767  000000  172002'         BIS     #0,DSR                  ;GIVE A GOOD BEEP NOW.
    1403 007152 162767  000012  170772          SUB     #10.,RADIUS             ;NOW PRODUCE SOME MORE DOTS.
    1404 007160 004767  000046                  JSR     PC,EXGEN
    1405 007164 012725  173400                  MOV     #DISTOP,(TEMP2)+        ;TERMINATE THE PICTURE NOW.
    1406 007170 005015                          CLR     (TEMP2)
    1407 007172 012767  032714' 023104          MOV     #EXLIST,FSUBC           ;MAKE SURE WE'RE SHOWING IT.
    1408 007200 052767  000000  172002'         BIS     #0,DSR                  ;GIVE A RANDOM BEEP, AT TIMES.
    1409 007206 062767  000041  170736          ADD     #33.,RADIUS             ;FINALLY INCREMENT RADIUS AND CHECK
    1410 007214 026727  170732  000300          CMP     RADIUS,#300             ;DONE?
    1411 007222 003731                          BLE     EXPLD1                  ;NOPE.
    1412 007224 004767  002424                  JSR     PC,DELAY                ;DELAY NOW BEFORE RESTARTING.
    1413 007230 000005                          .WORD   5.                      ;FIVE SECONDS.
    1414 007232 012767  177742  170542  EXGEN:  MOV     #-30.,ANGLE             ;INITIALIZE THE ANGLE NOW.
    1415 007240 012746  000361                  MOV     #241.,-(SP)             ;AND SET COUNTER TO DO -30 TO 210 DEGREES.
    1416 007244 004767  172636          EXGENL: JSR     PC,TRIG                 ;FIGURE OUT VARIOUS ANGLES NOW.
    1417 007250 016600  177772                  MOV     -6(SP),IN1              ;PICK UP RANDOM INTERUPT NUMBER NOW.
    1418 007254 006200                          ASR     IN1                     ;JUST IN CASE IT WAS EVEN.
    1419 007256 005200                          INC     IN1                     ;INCREMENT IT NOW.
    1420 007260 066700  170570                  ADD     TIME,IN1                ;ADD IN THE TIME ALSO.
    1421 007264 066700  170660                  ADD     XTYPE,IN1               ;AND ALSO THE PREVIOUS NUMBER.
    1422 007270 010067  170654                  MOV     IN1,XTYPE               ;AND SAVE IT AWAY NOW.
    1423 007274 042700  177740                  BIC     #-40,IN1                ;MAKE IT BETWEEN 0 AND 31
    1424 007300 116004  023565'                 MOVB    YUPDWN(IN1),TEMP        ;SO THAT WE CAN USE THE FLAME TABLE.
    1425 007304 066704  170642                  ADD     RADIUS,TEMP             ;GET A NEW RADIUS NOW.
    1426 007310 100433                          BMI     EXGENP                  ;IF MINUS, FORGET ABOUT IT.
    1427 007312 010400                          MOV     TEMP,IN1                ;ELSE GET THE SINES AND COSINES.
    1428 007314 016701  170470                  MOV     COSANG,IN2              ;SO WE CAN GET THE X AND THE
    1429 007320 004767  001614                  JSR     PC,TRGMUL               ;Y POINTS FOR THE EXPLOSION.
    1430 007324 066702  022736                  ADD     SHOWX,RET1              ;WE'VE GOT OUR X NOW.
    1431 007330 100423                          BMI     EXGENP                  ;MINUS IS A BADDY.
    1432 007332 052702  040000                  BIS     #INT,RET1               ;DON'T FORGET TO TURN ON INTENSIFY BIT.
    1433 007336 010225                          MOV     RET1,(TEMP2)+           ;AND PLACE IT AWAY NOW.
    1434 007340 010400                          MOV     TEMP,IN1                ;NOW GET THE Y.
    1435 007342 016701  170440                  MOV     SINANG,IN2
    1436 007346 004767  001566                  JSR     PC,TRGMUL
    1437 007352 066702  022712                  ADD     SHOWY,RET1
    1438 007356 100407                          BMI     EXGENO                  ;IF THIS IS BAD, WE MUST BACK UP.
    1439 007360 010225                          MOV     RET1,(TEMP2)+
    1440 007362 005267  170414          EXGEND: INC     ANGLE                   ;NOW GET THE NEXT ANGLE.
    1441 007366 005316                          DEC     (SP)                    ;AND WAIT TILL DONE.
    1442 007370 003325                          BGT     EXGENL                  ;AND LOOP TILL DONE.
    1443 007372 005726                          TST     (SP)+                   ;AND THEN EXIT.
    1444 007374 000207                          RTS     PC                      ;THIS INSTRUCTION HELPS IF ONE LEAVES IT IN.
    1445 007376 005045                  EXGENO: CLR     -(TEMP2)                ;IF X IS ALREADY THERE, TAKE IT BACK.
    1446 007400 005025                  EXGENP: CLR     (TEMP2)+                ;INSERT DUMMY'S SO DISPLAY WON'T SCREW UP.
    1447 007402 005025                          CLR     (TEMP2)+
    1448 007404 000766                          BR      EXGEND                  ;AND SEE IF ALL DONE.
    1449                                        .PAGE
    1450                                ;
    1451                                ;               NOTE, ANY ADDITIONAL CRAP YOU WISH TO PUT
    1452                                ;               IN MAY GO HERE.
    1453                                ;
    1454 007406 004767  177064          DRAWM2: JSR     PC,DRAWMC               ;THIS ROUTINE WILL THE CLOSE-UP
    1455 007412 005067  170530                  CLR     DFUDGE                  ;VIEW OF THE MOON.
    1456 007416 016700  170436                  MOV     LEFTEDGE,IN1            ;PICK UP LEFT SIDE OF THE SCREEN.
    1457 007422 006300                          ASL     IN1
    1458 007424 062700  024362'                 ADD     #TERAIN,IN1             ;GET POINTER TO LEFT Y.
    1459 007430 011004                          MOV     (IN1),TEMP              ;GET LEFT Y.
    1460 007432 004767  000360                  JSR     PC,DFAKE                ;MAKE INTO GOOD RASTOR.
    1461 007436 005704                          TST     TEMP                    ;SEE IF ON THE SCREEN NOW.
    1462 007440 100002                          BPL     DRW2L5                  ;IF POSITIVE OK,
    1463 007442 005004                          CLR     TEMP                    ;ELSE ZERO IT OUT.
    1464 007444 000405                          BR      DRW2M
    1465 007446 020427  002000          DRW2L5: CMP     TEMP,#1024.             ;SEE IF TOO BIG.
    1466 007452 103402                          BLO     DRW2M                   ;NOPE. OK
    1467 007454 012704  001777                  MOV     #1023.,TEMP             ;ELSE FIX IT UP.
    1468 007460 010425                  DRW2M:  MOV     TEMP,(TEMP2)+           ;INSERT STARTING Y INTO BUFFER.
    1469 007462 010467  170410                  MOV     TEMP,LASTY              ;ESTABLISH LAST Y POSITION NOW.
    1470 007466 012725  106120                  MOV     #SETSVM,(TEMP2)+        ;INSERT THE GRAPH PLOT MODE COMMAND <Y>.
    1471 007472 010446                  DRW2L:  MOV     TEMP,-(SP)              ;NOW GET Y(NEW) AND DELTA Y.
    1472 007474 012004                          MOV     (IN1)+,TEMP
    1473 007476 004767  000314                  JSR     PC,DFAKE
    1474 007502 010401                          MOV     TEMP,IN2
    1475 007504 012604                          MOV     (SP)+,TEMP
    1476 007506 005002                          CLR     RET1                    ;CLEAR AWAY LEFT MOST PART FOR THE DIVIDE.
    1477 007510 010046                          MOV     IN1,-(SP)               ;SAVE IN1 NOW.
