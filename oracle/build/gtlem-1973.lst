    2071                                ;
    2072                                ;               THIS ROUTINE IS CALLED WHENEVER THE LIGHT PEN HITS
    2073                                ;               THE THROTTLE BAR.
    2074                                ;
    2075 012162 016701  172006'         LPBARH: MOV     YSR,IN2                 ;GET THE Y COORDINATE.
    2076 012166 042701  176000                  BIC     #-2000,IN2              ;MAKE IT JUST 10 BITS.
    2077 012172 062701  000015                  ADD     #BARADD,IN2             ;ADD FUDGE FACTOR NOW.
    2078 012176 016700  010452                  MOV     LPBARY,IN1              ;PICK UP OLD Y NOW.
    2079 012202 006300                          ASL     IN1                     ;AND MULTIPLY IT BY 8.
    2080 012204 006300                          ASL     IN1
    2081 012206 006300                          ASL     IN1
    2082 012210 166700  010440                  SUB     LPBARY,IN1              ;WE REALLY ONLY WANTED 7.
    2083 012214 060001                          ADD     IN1,IN2                 ;NOW MAKE IT 7*OLD+NEW Y.
    2084 012216 006201                          ASR     IN2
    2085 012220 006201                          ASR     IN2
    2086 012222 006201                          ASR     IN2                     ;NOW AVERAGE IT OUT.
    2087 012224 010167  010424                  MOV     IN2,LPBARY              ;SAVE THE Y VALUE NOW.
    2088 012230 162701  000733                  SUB     #BARFDG,IN2             ;SUBTRACT BASE Y NOW.
    2089 012234 006201                          ASR     IN2                     ;DIVIDE BY TWO.
    2090 012236 020127  000012                  CMP     IN2,#MINTRS             ;COMPARE AGAINST MINIMUM THRUST.
    2091 012242 100002                          BPL     LPBARP                  ;GREATER OR EQUAL. IT'S OK.
    2092 012244 012701  000012                  MOV     #MINTRS,IN2             ;ELSE SET TO THE MINIMUM THRUST.
    2093 012250 022701  000144          LPBARP: CMP     #100.,IN2               ;LIKEWISE IF GREATER THEN 100, MAKE
    2094 012254 002002                          BGE     LPBARQ                  ;IT ONLY 100.
    2095 012256 012701  000144                  MOV     #100.,IN2
    2096 012262 010167  165546          LPBARQ: MOV     IN2,PERCNT              ;SAVE AWAY THE VALUE NOW.
    2097 012266 052767  000001  172000' LPRESM: BIS     #1,DPC                  ;RESUME THE DISPLAY NOW.
    2098 012274 012601                          MOV     (SP)+,IN2               ;RESTORE THE REGISTERS NOW.
    2099 012276 012600                          MOV     (SP)+,IN1               ;AND THEN EXIT.
    2100 012300 000002                          RTI
    2101 012302 016101  012410'         LPIT1:  MOV     DLIST(IN2),IN2          ;GET POINTER TO USER'S DISPAY ITEM.
    2102 012306 016700  165612                  MOV     LPFLG1,IN1              ;AND PICK UP PREVIOUS ITEM NOW.
    2103 012312 001403                          BEQ     LPIT1P                  ;IF ZERO, NO PREVIOUS BLINKING.
    2104 012314 042760  000010  000002          BIC     #10,2(IN1)              ;ELSE CLEAR OUT THE BLINK BITS.
    2105 012322 010167  165576          LPIT1P: MOV     IN2,LPFLG1              ;SAVE IT AWAY FOR DISPLAY TRANSFER.
    2106 012326 052761  000030  000002          BIS     #30,2(IN2)              ;SET IT BLINKING NOW.
    2107 012334 000754                          BR      LPRESM                  ;AND RESUME THE DISPLAY NOW.
    2108 012336 016700  165562          LPIT2:  MOV     LPFLG1,IN1              ;GET HIS POINTER.
    2109 012342 001751                          BEQ     LPRESM                  ;NONE SPECIFIED.
    2110 012344 005067  165554                  CLR     LPFLG1                  ;CLEAR POINTER NOW.
    2111 012350 010061  013216'                 MOV     IN1,DIALTB-LPBASE+DLIST(IN2)    ;CHANGE OUR POINTER NOW.
    2112 012354 042760  000010  000002          BIC     #10,2(IN1)              ;AND CLEAR THE BLINK FLAG NOW.
    2113 012362 000741                          BR      LPRESM                  ;AND RESUME THE DISPLAY NOW.
    2114 012364 016101  012410'         ARROW:  MOV     DLIST(IN2),IN2          ;ON ARROW HIT, COME HERE. PICK UP ADDRESS.
    2115 012370 016167  177776  165402          MOV     -2(IN2),TURN            ;AND MOVE OVER RATE OF TURN.
    2116 012376 010167  000072                  MOV     IN2,DLIST1              ;AND ALSO MAKE IT BRIGHTER.
    2117 012402 010167  000070                  MOV     IN2,DLIST2
    2118 012406 000727                          BR      LPRESM                  ;AND RESUME NOW.
